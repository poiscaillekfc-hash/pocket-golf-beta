 let nx=m,ny=-1;let len=Math.hypot(nx,ny);nx/=len;ny/=len;
 // correct penetration along surface normal, retain tangential velocity
 const depth=ball.y+R-g;ball.x+=nx*Math.min(4,depth*.3);ball.y=cy(l,ball.x)-R;
 const vn=ball.vx*nx+ball.vy*ny;
 if(vn< -68){collideNormal(nx,ny,.38,.89)}else{
 const tx=1/len,ty=m/len,along=ball.vx*tx+ball.vy*ty;
 let next=along+G*ty*dt;const resist=125*dt;
 if(Math.abs(next)<resist && Math.abs(G*ty)<125){next=0}else next-=Math.sign(next)*Math.min(resist,Math.abs(next));
 ball.vx=tx*next;ball.vy=ty*next;
 }
 ball.grounded=true;
 }else ball.grounded=false;
 const cupx=l.cup,cupy=cy(l,cupx);
 if(Math.abs(ball.x-cupx)<19&&ball.y+R>=cupy-15&&ball.y+R<=cupy+19&&Math.abs(ball.vx)<255&&ball.vy<190){ball.x=cupx;ball.y=cupy-2;endHole(true);return}
 if(ball.grounded&&Math.hypot(ball.vx,ball.vy)<12)restTime+=dt;else restTime=0;
 if(restTime>.55||elapsed>14){ball.vx=ball.vy=0;ball.y=safeHeight(l,ball.x);ball.grounded=true;mode='ready';restTime=0;if(shots>=3)endHole(false);else doToast('À toi de jouer !')}
}
function path(points,fill){ctx.beginPath();ctx.moveTo(points[0][0],points[0][1]);for(let i=1;i<points.length;i++)ctx.lineTo(points[i][0],points[i][1]);ctx.closePath();ctx.fillStyle=fill;ctx.fill()}
function rrect(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
function line(x1,y1,x2,y2,width,color){ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.lineWidth=width;ctx.lineCap='round';ctx.strokeStyle=color;ctx.stroke()}
function background(){
 const sky=ctx.createLinearGradient(0,0,0,MH);sky.addColorStop(0,'#4dbafa');sky.addColorStop(.6,'#9ae1f8');sky.addColorStop(1,'#d7f5ce');ctx.fillStyle=sky;ctx.fillRect(0,0,MW,MH);
 if(artwork.complete&&artwork.naturalWidth){ctx.drawImage(artwork,0,0,MW,440)}
 // Distant meadow is the same sunlit atmosphere as the scenery behind it.
 let f=ctx.createLinearGradient(0,360,0,535);f.addColorStop(0,'#9fdb88'+'00');f.addColorStop(.60,'#8dd68866');f.addColorStop(1,'#a5e58e');ctx.fillStyle=f;ctx.fillRect(0,345,MW,200);
}

function terrain(){
 const l=levels[level],y0=cy(l,0);
 // One single continuous soil silhouette; water is carved out before grass is applied.
 ctx.beginPath();ctx.moveTo(0,y0);for(let x=4;x<=MW;x+=4)ctx.lineTo(x,cy(l,x));ctx.lineTo(MW,MH+20);ctx.lineTo(0,MH+20);ctx.closePath();
 const earth=ctx.createLinearGradient(0,405,0,655);earth.addColorStop(0,'#bd7c48');earth.addColorStop(.28,'#b46d40');earth.addColorStop(.75,'#91512e');earth.addColorStop(1,'#784125');ctx.fillStyle=earth;ctx.fill();
 ctx.save();ctx.clip();
 // Painterly strata, not the flat red slabs of old prototypes.
 for(let k=0;k<5;k++){ctx.beginPath();ctx.moveTo(0,cy(l,0)+23+k*40);for(let x=0;x<=MW;x+=12)ctx.lineTo(x,cy(l,x)+23+k*40+Math.sin(x/73+k*1.42)*7+Math.cos(x/38+k)*2);ctx.lineTo(MW,MH+20);ctx.lineTo(0,MH+20);ctx.closePath();ctx.fillStyle=['#c18b55','#bb7949','#a96339','#99592f','#834629'][k];ctx.globalAlpha=k===0?.39:.22;ctx.fill();}ctx.globalAlpha=1;
 // Warm speckles and pebbles; deterministic so they stay still while playing.
 for(let j=0;j<285;j++){let x=(j*7919%1199)+.5,y=cy(l,x)+18+(j*1777%164);if(y>MH)continue;const r=1+(j%5)*.6;ctx.fillStyle=j%4===0?'#e2b982':j%4===1?'#7e5034':j%4===2?'#d49a61':'#a66a3d';ctx.globalAlpha=.26+(j%3)*.1;ctx.beginPath();ctx.ellipse(x,y,r*1.8,r,((j%11)-5)*.12,0,Math.PI*2);ctx.fill();}ctx.globalAlpha=1;
 ctx.restore();
 // Carved ponds, banks and surface in the same earth silhouette.
 for(const [a,b] of l.water){const ya=cy(l,a),yb=cy(l,b),top=Math.min(ya,yb)-1;
   ctx.beginPath();ctx.moveTo(a-9,ya-2);ctx.quadraticCurveTo(a+15,top+13,a+26,top+12);ctx.lineTo(b-26,top+12);ctx.quadraticCurveTo(b-15,top+13,b+9,yb-2);ctx.lineTo(b+9,MH+20);ctx.lineTo(a-9,MH+20);ctx.closePath();ctx.fillStyle='#184b6c';ctx.fill();
   ctx.beginPath();ctx.moveTo(a-3,ya+1);ctx.quadraticCurveTo(a+20,top+12,a+29,top+13);ctx.lineTo(b-29,top+13);ctx.quadraticCurveTo(b-20,top+12,b+3,yb+1);ctx.lineTo(b+3,MH+20);ctx.lineTo(a-3,MH+20);ctx.closePath();ctx.save();ctx.clip();
   let waterGrad=ctx.createLinearGradient(0,top,0,top+145);waterGrad.addColorStop(0,'#81eff7');waterGrad.addColorStop(.26,'#20b8eb');waterGrad.addColorStop(1,'#1277b4');ctx.fillStyle=waterGrad;ctx.fillRect(a-12,top,b-a+24,MH-top+20);ctx.restore();
 }
 // Multilayer grass edge with a readable contact line.
 for(const [a,b] of solidRanges(l)){
  ctx.beginPath();ctx.moveTo(a,cy(l,a));for(let x=a+3;x<b;x+=3)ctx.lineTo(x,cy(l,x));ctx.lineTo(b,cy(l,b));ctx.lineJoin='round';ctx.lineCap='round';ctx.strokeStyle='#305f32';ctx.lineWidth=25;ctx.stroke();ctx.strokeStyle='#3b9a36';ctx.lineWidth=20;ctx.stroke();ctx.strokeStyle='#78d843';ctx.lineWidth=15;ctx.stroke();ctx.strokeStyle='#c1f16a';ctx.lineWidth=4.5;ctx.stroke();
 }
 // Blades, little blooms and ambient contact shadows.
 for(let j=0;j<175;j++){let x=(j*1277+61)%MW;if(inWater(l,x))continue;let y=cy(l,x)-9;ctx.strokeStyle=j%3===0?'#e6f68b':j%3===1?'#4ea93d':'#80dc47';ctx.lineWidth=1+(j%3)*.3;ctx.beginPath();ctx.moveTo(x,y+4);ctx.quadraticCurveTo(x+((j%5)-2)*2,y-2-(j%4)*2,x+((j%7)-3),y-4-(j%4)*2);ctx.stroke();if(j%19===0){ctx.fillStyle='#ffffff';for(let p=0;p<5;p++){let ang=p*Math.PI*2/5;ctx.beginPath();ctx.arc(x+Math.cos(ang)*4,y-6+Math.sin(ang)*4,2,0,Math.PI*2);ctx.fill()}ctx.fillStyle='#f4cd45';ctx.beginPath();ctx.arc(x,y-6,2,0,Math.PI*2);ctx.fill()}}
}
function solidRanges(l){let ranges=[],from=0;for(const [a,b] of l.water){ranges.push([from,Math.max(from,a-7)]);from=Math.min(MW,b+7)}ranges.push([from,MW]);return ranges.filter(q=>q[1]>q[0]);}
function water(){const l=levels[level];for(const [a,b] of l.water){const top=Math.min(cy(l,a),cy(l,b))+11;ctx.save();ctx.beginPath();ctx.rect(a+13,top,b-a-26,57);ctx.clip();for(let k=0;k<4;k++){ctx.beginPath();for(let x=a+15;x<b-13;x+=5){let y=top+9+k*10+Math.sin(x*.055+t*(1+k*.15)+k)*2;if(x===a+15)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.strokeStyle=k===0?'#eeffffbd':'#79e7f6a3';ctx.lineWidth=k===0?2.8:1.8;ctx.stroke()}ctx.restore()}}

function tree(tr){const sc=tr.s,x=tr.x,base=tr.base;
 const pineTier=(tip,half,depth,col,light)=>{const pts=[[x,tip],[x-half,tip+depth],[x-half*.65,tip+depth-5*sc],[x,tip+depth+7*sc],[x+half*.65,tip+depth-5*sc],[x+half,tip+depth]];ctx.beginPath();ctx.moveTo(...pts[0]);for(const p of pts.slice(1))ctx.lineTo(...p);ctx.closePath();ctx.fillStyle=col;ctx.fill();ctx.strokeStyle='#11334e';ctx.lineWidth=5*sc;ctx.lineJoin='round';ctx.stroke();path([[x,tip],[x-half*.25,tip+depth*.8],[x-half*.7,tip+depth*.83],[x,tip+depth+7*sc]],light)};
 if(tr.kind==='solid'){line(x,base,x,base-95*sc,22*sc,'#12334e');line(x,base,x,base-95*sc,13*sc,'#a96a36');
 pineTier(base-176*sc,38*sc,80*sc,'#54d316','#9ce83d');pineTier(base-136*sc,53*sc,75*sc,'#24b82b','#64da1b');pineTier(base-97*sc,64*sc,72*sc,'#0caa34','#49d52c');
 }else{const w=115*sc,h=116*sc,top=base-h,lx=x-w/2,rx=x+w/2;
 // thick hollow arch, center remains open and collision-free
 rrect(lx-2,top+34*sc,21*sc,h-32*sc,5*sc,'#11344c');rrect(rx-19*sc,top+34*sc,21*sc,h-32*sc,5*sc,'#11344c');rrect(lx+3,top+35*sc,13*sc,h-37*sc,3,'#a76534');rrect(rx-16*sc,top+35*sc,13*sc,h-37*sc,3,'#a76534');
 rrect(lx-4,top-4,w+8,30*sc,7*sc,'#12334e');rrect(lx+1,top,w-2,20*sc,6*sc,'#8b4d25');
 pineTier(top-64*sc,72*sc,72*sc,'#20b638','#71dd30');pineTier(top-100*sc,52*sc,66*sc,'#35c629','#a5e449');
 }}
function rocksAndBridges(){const l=levels[level];for(const r of l.rocks){let x=r.x,y=r.y,z=r.r;ctx.fillStyle='#1b4e5370';ctx.beginPath();ctx.ellipse(x+2,y+z*.65,z*1.2,z*.38,0,0,Math.PI*2);ctx.fill();let gr=ctx.createLinearGradient(x-z,y-z,x+z,y+z);gr.addColorStop(0,'#e9e1d2');gr.addColorStop(.38,'#9eb5b9');gr.addColorStop(1,'#607c90');ctx.fillStyle=gr;ctx.beginPath();ctx.moveTo(x-z,y+z*.38);ctx.lineTo(x-z*.67,y-z*.53);ctx.lineTo(x-z*.05,y-z);ctx.lineTo(x+z*.63,y-z*.55);ctx.lineTo(x+z,y+z*.46);ctx.lineTo(x+z*.16,y+z*.86);ctx.closePath();ctx.fill();path([[x-z*.67,y-z*.53],[x-z*.05,y-z],[x+z*.14,y-z*.33],[x-z*.35,y+z*.25]],'#eaf1e7a8');}
 for(const b of l.bridges){rrect(b.x-3,b.y-4,b.w+6,b.h+8,6,'#6c4a31');rrect(b.x,b.y,b.w,b.h,5,'#ae7544');for(let x=b.x+12;x<b.x+b.w;x+=24)line(x,b.y+2,x-4,b.y+b.h-2,2,'#dbab73')}
}
function flag(){const l=levels[level],x=l.cup,y=cy(l,x);ctx.fillStyle='#243c2944';ctx.beginPath();ctx.ellipse(x,y+5,24,7,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#23372a';ctx.beginPath();ctx.ellipse(x,y-1,18,4,0,0,Math.PI*2);ctx.fill();line(x+11,y,x+11,y-90,4,'#f6f6ef');ctx.fillStyle='#f25852';ctx.beginPath();ctx.moveTo(x+12,y-89);ctx.quadraticCurveTo(x-7,y-98,x-41,y-82);ctx.quadraticCurveTo(x-10,y-71,x+12,y-65);ctx.closePath();ctx.fill();ctx.lineWidth=2;ctx.strokeStyle='#de5750';ctx.stroke()}

function drawBall(){const l=levels[level],yy=cy(l,ball.x);ctx.save();ctx.fillStyle='#163d3866';ctx.beginPath();ctx.ellipse(ball.x+1,yy+6,16,4,0,0,Math.PI*2);ctx.fill();ctx.translate(ball.x,ball.y);ctx.rotate(ball.angle);let gr=ctx.createRadialGradient(-5,-6,1,0,0,R+2);gr.addColorStop(0,'#ffffff');gr.addColorStop(.58,'#f6fdff');gr.addColorStop(1,'#b0d0d8');ctx.fillStyle=gr;ctx.beginPath();ctx.arc(0,0,R,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#e0f7f6';ctx.lineWidth=1.3;ctx.stroke();ctx.fillStyle='#8caeac77';for(const [px,py] of [[-3,-3],[4,-1],[0,5]]){ctx.beginPath();ctx.arc(px,py,1.6,0,Math.PI*2);ctx.fill()}ctx.restore()}

function drawnAim(){if(!aiming||mode!=='ready')return;const dx=start.x-cursor.x,dy=start.y-cursor.y,len=Math.hypot(dx,dy),p=clamp(len/MAX_DRAG,0,1);if(len<2)return;const ux=dx/len,uy=dy/len;
 // Straight aiming line IN THE SHOOTING DIRECTION; pull goes the opposite way.
 line(ball.x+ux*16,ball.y+uy*16,ball.x+ux*185,ball.y+uy*185,5,'#ffffffd9');
 line(ball.x+ux*16,ball.y+uy*16,ball.x+ux*(35+p*110),ball.y+uy*(35+p*110),10,'#ffffff');
 // back-drag power strip, translucent track and solid orange fill
 line(ball.x-ux*19,ball.y-uy*19,ball.x-ux*145,ball.y-uy*145,17,'#24576850');
 line(ball.x-ux*19,ball.y-uy*19,ball.x-ux*(19+p*126),ball.y-uy*(19+p*126),11,p>.84?'#ff6a5b':'#ffca56');
 ctx.fillStyle='#ffffff';ctx.font='900 17px system-ui';ctx.textAlign='center';ctx.fillText(Math.round(p*100)+'%',ball.x-ux*73,ball.y-uy*73-22);ctx.textAlign='start'
}
function roundHud(){
 const panel=(x,y,w,h)=>{ctx.save();ctx.shadowColor='#143d4c66';ctx.shadowBlur=11;ctx.shadowOffsetY=4;rrect(x,y,w,h,17,'#183d55db');ctx.shadowColor='transparent';ctx.lineWidth=1.6;ctx.strokeStyle='#ffffffaa';ctx.beginPath();ctx.roundRect(x,y,w,h,17);ctx.stroke();ctx.restore()};
 panel(20,17,228,55);ctx.fillStyle='#fff';ctx.font='900 20px system-ui';ctx.fillText(`⛳ Trou ${level+1} / 12`,34,43);ctx.font='700 13px system-ui';ctx.fillStyle='#daebef';ctx.fillText(`${score} points  ·  3 max`,75,61);
 panel(464,17,272,54);ctx.font='900 25px system-ui';ctx.fillStyle='#fff';ctx.textAlign='center';ctx.fillText(levels[level].wind===0?'Pas de vent':windMark(levels[level].wind),600,53);ctx.textAlign='left';
 panel(917,17,195,54);ctx.fillStyle='#fff';ctx.font='850 19px system-ui';ctx.fillText(`Coups : ${shots}`,934,51);
 panel(1130,17,50,54);ctx.fillStyle='#fff';ctx.font='900 27px system-ui';ctx.fillText('Ⅱ',1143,51);
 if(aiming){ctx.save();ctx.shadowColor='#143d4c77';ctx.shadowBlur=12;rrect(419,555,362,39,19,'#163e55c9');ctx.shadowColor='transparent';let gr=ctx.createLinearGradient(427,0,772,0);gr.addColorStop(0,'#5ae944');gr.addColorStop(.45,'#f7e451');gr.addColorStop(.8,'#ff923d');gr.addColorStop(1,'#f45256');rrect(426,563,348*power,23,10,gr);ctx.strokeStyle='#ffffffaa';ctx.lineWidth=1.5;ctx.beginPath();ctx.roundRect(419,555,362,39,19);ctx.stroke();ctx.restore();}
 else if(mode==='ready'){ctx.fillStyle='#fff9';ctx.font='750 15px system-ui';ctx.textAlign='center';ctx.fillText('Glisse en arrière pour tirer',600,591);ctx.textAlign='left'}
}
function drawCelebration(dt){for(const p of celebration){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=G*.55*dt;p.life-=dt;ctx.globalAlpha=clamp(p.life,0,1);ctx.fillStyle=p.col;ctx.fillRect(p.x,p.y,p.r,p.r)}ctx.globalAlpha=1;celebration=celebration.filter(p=>p.life>0)}
function render(dt){ctx.setTransform(dpr*sx,0,0,dpr*sy,0,0);ctx.fillStyle='#86e2f2';ctx.fillRect(0,0,MW,MH);ctx.save();if(cameraShake>.02){ctx.translate((Math.random()-.5)*cameraShake,(Math.random()-.5)*cameraShake);cameraShake*=.86}background();terrain();water();rocksAndBridges();for(const tr of levels[level].trees)tree(tr);flag();drawBall();drawnAim();drawCelebration(dt);ctx.restore();roundHud()}
function loop(ms){if(!last)last=ms;const dt=Math.min(.05,(ms-last)/1000);last=ms;t+=dt;acc=Math.min(.08,acc+dt);while(acc>=STEP){step(STEP);acc-=STEP}render(dt);requestAnimationFrame(loop)}
canvas.addEventListener('click',e=>{let p=pointFromEvent(e);if(p.x>1100&&p.y>12&&p.y<70&&mode!=='intro'&&mode!=='modal'){(()=>{const resumeMode=mode;modal('Pause','⛳','PAUSE',`Trou ${level+1} sur 12. Score actuel : <b>${score} pts</b>.`,'Continuer',()=>{mode=resumeMode},'Recommencer le monde',restart)})()}});
setLevel(0);modal('BÊTA 0.6 · GREEN VALLEY','⛳','POCKET GOLF',`<b>12 trous · 3 coups chacun.</b><br>Touche l’écran, <b>glisse ton doigt vers l’arrière</b> et relâche. Le trait blanc indique la direction du tir, la barre colorée sa puissance.<br>Le vent pousse réellement la balle pendant son vol.`,`JOUER MAINTENANT`,restart,'Meilleur score : '+highScore+'/36',()=>{mode='ready'});
requestAnimationFrame(loop);
})();
</script></body></html>
