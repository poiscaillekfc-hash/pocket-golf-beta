<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,maximum-scale=1,user-scalable=no"><meta name="theme-color" content="#83e2f4"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Pocket Golf"><title>Pocket Golf — Green Valley 1.0 · Édition Atlas</title>
<style>
:root{color-scheme:light}*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;overflow:hidden;width:100%;height:100%;background:#82e0f1;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;touch-action:none;overscroll-behavior:none}#gameStage{position:absolute;inset:0;overflow:hidden;touch-action:none}canvas{display:block;width:100%;height:100%;touch-action:none}#overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#123b4b87;backdrop-filter:blur(8px);padding:18px;z-index:5}#overlay.hidden{display:none}.dialog{border:3px solid #fff7e5;width:min(460px,94%);max-height:92%;overflow:auto;background:linear-gradient(180deg,#fffefa,#ecfaf5);box-shadow:0 14px 0 #1c677d45,0 26px 65px #1c425c68;border-radius:27px;padding:21px 25px 20px;text-align:center;color:#254957}.eyebrow{font-size:11px;color:#248f78;letter-spacing:2.3px;font-weight:950;text-transform:uppercase}.dialog h1{margin:7px 0 7px;line-height:1.06;font-size:clamp(25px,4.3vw,39px);color:#224c5c;letter-spacing:-1px}.dialog p{font-size:13px;line-height:1.52;margin:8px auto 0;max-width:385px;color:#617985}.hero{font-size:31px;line-height:1.2;margin:3px}.points{font-size:27px;font-weight:1000;color:#24af7c;margin-top:7px}.dialog button{cursor:pointer;border:0;background:#ffcc55;color:#644310;font-weight:950;border-radius:13px;width:100%;font-size:16px;padding:12px 16px;margin-top:15px;box-shadow:0 4px 0 #dba333}.dialog button:active{transform:translateY(2px)}.dialog .secondary{background:#e9f3f1;box-shadow:none;color:#36718a;margin-top:8px;font-size:12px}.small{font-size:10px!important;color:#8c9ca2!important}#toast{position:absolute;bottom:17%;left:50%;transform:translateX(-50%);padding:9px 16px;border-radius:99px;background:#1f617acb;backdrop-filter:blur(9px);color:#fff;font-size:13px;font-weight:850;pointer-events:none;opacity:0;transition:opacity .2s;white-space:nowrap;z-index:3}#toast.show{opacity:1}@media(orientation:portrait){#gameStage{inset:auto;left:100vw;top:0;width:100dvh;height:100vw;transform-origin:top left;transform:rotate(90deg)}.dialog{padding:14px 20px;border-radius:18px}.dialog h1{font-size:26px}.dialog p{font-size:11px}.dialog button{padding:9px}.hero{font-size:22px}}@media (max-height:380px) and (orientation:landscape){.dialog{padding:10px 18px}.dialog h1{font-size:24px}.dialog p{font-size:11px}.dialog button{margin-top:8px;padding:8px}.hero{font-size:22px}}

#menu{position:absolute;inset:0;z-index:4;display:flex;align-items:center;justify-content:center;overflow:hidden;color:#fff;text-align:center;pointer-events:auto;background:linear-gradient(110deg,#0b466e46,#013f4870)}#menu.hidden{display:none}
.menu-glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse at 50% 39%,#e5fff320 0%,transparent 56%),linear-gradient(0deg,#08282a8c,transparent 47%)}
.menu-inner{position:relative;width:min(1000px,95%);height:94%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;filter:drop-shadow(0 5px 9px #0d425788)}
.menu-crest{font-size:clamp(25px,5vh,45px);filter:drop-shadow(0 4px 1px #32636a)}.menu-brand{font-family:system-ui,-apple-system,sans-serif;font-size:clamp(38px,9vh,83px);font-weight:1000;line-height:1;letter-spacing:-3px;color:#fff9dc;-webkit-text-stroke:2px #326a65;text-shadow:0 5px 0 #26836c,0 9px 0 #135774,0 14px 22px #183a5399}.menu-subtitle{font-weight:900;text-transform:uppercase;letter-spacing:4px;font-size:clamp(10px,2.4vh,17px);color:#effff3;text-shadow:0 2px 6px #12445f}.menu-button{touch-action:manipulation;min-width:215px;border:3px solid #fffce1;border-radius:17px;padding:14px 36px;background:linear-gradient(180deg,#ffe68b 0%,#ffbf4c 74%,#efa739 100%);box-shadow:0 7px 0 #ac742e,0 12px 22px #18455d85;font:1000 23px system-ui;color:#71501c;cursor:pointer;transition:transform .14s}.menu-button:active{transform:translateY(4px);box-shadow:0 3px 0 #ac742e}.menu-small{font-weight:750;font-size:12px;color:#f3ffeb;text-shadow:0 2px 4px #184b5b}
#homeView,#worldView{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(9px,2vh,18px)}#worldView{display:none}#menu.world-view #homeView{display:none}#menu.world-view #worldView{display:flex}
.world-title{font-size:clamp(25px,5.5vh,44px);font-weight:1000;color:#fff8da;letter-spacing:-1px;text-shadow:0 4px 0 #26746b,0 7px 12px #174154}.world-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;width:min(950px,95%)}.world-card{position:relative;min-height:clamp(130px,29vh,220px);border:3px solid #f2fae4;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:end;padding:13px 5px;background:linear-gradient(180deg,#7cc2e870,#265c5477);box-shadow:0 6px 0 #215a5e,0 9px 25px #133e5999;color:#fff;font:900 16px system-ui;text-shadow:0 2px 7px #193e4e;cursor:pointer;isolation:isolate}.world-card:before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 50% 30%,#fff8b899,transparent 55%),linear-gradient(180deg,#86dced 15%,#32834f 64%,#1e6f4a 100%)}.world-card.desert:before{background:linear-gradient(160deg,#96d2ec,#f5c26e 56%,#ba784f)}.world-card.ice:before{background:linear-gradient(160deg,#458dc8,#a8e9f1 49%,#6aa7cc)}.world-card.space:before{background:radial-gradient(circle at 60% 30%,#996aca,#282c71 60%,#161e49)}.world-card.locked{cursor:default;filter:saturate(.75)}.world-icon{font-size:clamp(32px,8vh,57px);margin:auto 0 6px;filter:drop-shadow(0 4px 5px #264c5588)}.world-card span{font-size:clamp(11px,2.5vh,17px)}.world-card small{font-size:10px;letter-spacing:.7px;color:#fbffde}.world-back{border:2px solid #ffffffa6;border-radius:12px;background:#1b5467c7;color:white;padding:7px 22px;font:800 14px system-ui;cursor:pointer}
@media(orientation:portrait){.world-card{min-height:clamp(120px,26vw,200px)}.world-grid{gap:8px}.world-title{font-size:25px}.world-card{border-radius:14px}.menu-inner{gap:8px}}

/* Green Valley Atlas : navigation et lisibilité */
#levelView{display:none;width:100%;height:100%;flex-direction:column;align-items:center;justify-content:center;gap:clamp(7px,1.3vh,13px)}
#menu.level-view #homeView,#menu.level-view #worldView{display:none}
#menu.level-view #levelView{display:flex}
.level-grid{width:min(995px,97%);display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(6px,1.5vw,14px)}
.level-card{border-radius:16px;border:2px solid #fff9d8;background:linear-gradient(180deg,#a4e97c,#57b55b 67%,#3e9454);padding:9px 5px;min-height:clamp(65px,12vh,97px);color:#fffdf2;text-shadow:0 2px 3px #145f4a;font:900 13px system-ui;box-shadow:0 5px 0 #276951,0 7px 14px #11394866;cursor:pointer;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:4px;position:relative}
.level-card:active{transform:translateY(3px);box-shadow:0 2px 0 #276951}
.level-card .num{font-size:26px;line-height:1}.level-card .label{font-size:10px;line-height:1.1}.level-card .stars{font-size:10px;color:#fff7b0}
.level-card:hover{filter:brightness(1.08)}
#menu{background:linear-gradient(180deg,#103f4778,#0a323ec2)}
.menu-brand{color:#fffde6;-webkit-text-stroke:2px #234f4d;text-shadow:0 5px 0 #2c9b54,0 9px 0 #14577a,0 14px 22px #173c6099}
.world-card{background-size:cover;background-position:center}
@media(orientation:portrait){.level-grid{grid-template-columns:repeat(6,minmax(0,1fr));gap:5px}.level-card{min-height:54px;padding:3px}.level-card .num{font-size:17px}.level-card .label{display:none}.level-card .stars{font-size:8px}}
@media(max-height:430px) and (orientation:landscape){.level-card{min-height:62px}.level-card .num{font-size:20px}}
</style></head><body><main id="gameStage"><canvas id="g" aria-label="Pocket Golf, jeu de golf en deux dimensions"></canvas><div id="toast"></div><div id="menu"><div class="menu-glow"></div><div class="menu-inner"><div id="homeView"><div class="menu-crest">⛳ ✨</div><div class="menu-brand">POCKET<br>GOLF</div><div class="menu-subtitle">Une aventure, un swing à la fois</div><button class="menu-button" id="startMenu">▶ JOUER</button><div class="menu-small">Green Valley · Édition Atlas · 12 trous</div></div><div id="worldView"><div class="world-title">CHOISIS TON MONDE</div><div class="world-grid"><button class="world-card" id="worldOne"><div class="world-icon">🌲</div><span>GREEN VALLEY</span><small>12 TROUS · JOUER ▶</small></button><div class="world-card desert locked"><div class="world-icon">🏜️</div><span>DESERT DUNES</span><small>🔒 BIENTÔT</small></div><div class="world-card ice locked"><div class="world-icon">❄️</div><span>FROZEN PEAKS</span><small>🔒 BIENTÔT</small></div><div class="world-card space locked"><div class="world-icon">🪐</div><span>COSMIC GOLF</span><small>🔒 BIENTÔT</small></div></div><button class="world-back" id="menuBack">← RETOUR</button></div>
<div id="levelView"><div class="world-title">GREEN VALLEY <span style="color:#b8f4a3">· 12 TROUS</span></div><div class="level-grid" id="levelGrid"></div><div class="menu-small">Trois coups maximum · 3, 2 ou 1 point par trou · 36 points au total</div><button class="world-back" id="levelsBack">← MONDES</button></div></div></div><div id="overlay" class="hidden"><div class="dialog"><div class="eyebrow" id="tag">Green Valley · Monde 1</div><div class="hero" id="hero">⛳</div><h1 id="title">POCKET GOLF</h1><div class="points" id="points" hidden></div><p id="desc">12 trous, 3 coups par trou. Tire ton doigt <b>en arrière</b>, puis relâche : la balle part dans la direction opposée.</p><button id="go" type="button">JOUER →</button><button id="other" class="secondary" type="button" style="display:none"></button><p class="small" id="small">Édition Atlas · 12 trous</p></div></div></main>
<script>
(()=>{'use strict';
const el=id=>document.getElementById(id),canvas=el('g'),ctx=canvas.getContext('2d');
const MW=1200,MH=630,R=10.5,G=880,MAX_DRAG=165,SHOOT=7.4,STEP=1/180;
const atlasSources={"A1":"data:image/webp;base64,","A2":"data:image/webp;base64,","A3":"data:image/webp;base64,","A4":"data:image/webp;base64,","A5":"data:image/webp;base64,","C1":"data:image/webp;base64,","C2":"data:image/webp;base64,","C3":"data:image/webp;base64,","P1":"data:image/webp;base64,","P2":"data:image/webp;base64,","P3":"data:image/webp;base64,","R1":"data:image/webp;base64,","R2":"data:image/webp;base64,","R3":"data:image/webp;base64,","R4":"data:image/webp;base64,","R5":"data:image/webp;base64,","B1":"data:image/webp;base64,","B2":"data:image/webp;base64,","B3":"data:image/webp;base64,","B4":"data:image/webp;base64,","F1":"data:image/webp;base64,","F2":"data:image/webp;base64,","F3":"data:image/webp;base64,","F4":"data:image/webp;base64,","F5":"data:image/webp;base64,","O1":"data:image/webp;base64,","O2":"data:image/webp;base64,","O3":"data:image/webp;base64,","O4":"data:image/webp;base64,","O5":"data:image/webp;base64,","M1":"data:image/webp;base64,","M2":"data:image/webp;base64,","M3":"data:image/webp;base64,","M4":"data:image/webp;base64,","H1":"data:image/webp;base64,","H2":"data:image/webp;base64,","H3":"data:image/webp;base64,","N1":"data:image/webp;base64,","N2":"data:image/webp;base64,","N3":"data:image/webp;base64,","E1":"data:image/webp;base64,","E2":"data:image/webp;base64,","E3":"data:image/webp;base64,","E4":"data:image/webp;base64,","AMB1":"data:image/jpeg;base64,","AMB2":"data:image/jpeg;base64,","AMB3":"data:image/jpeg;base64,","AMB4":"data:image/jpeg;base64,","AMB5":"data:image/jpeg;base64,","AMB6":"data:image/jpeg;base64,"};
const atlas={};for(const [code,url] of Object.entries(atlasSources)){const im=new Image();im.src=url;atlas[code]=im;}
function drawAsset(code,x,base,w,h,alpha=1){const im=atlas[code];if(!im||!im.complete||!im.naturalWidth)return false;ctx.save();ctx.globalAlpha*=alpha;ctx.drawImage(im,x-w/2,base-h,w,h);ctx.restore();return true}
function groundShadow(x,y,w){ctx.save();ctx.fillStyle='#275b3761';ctx.beginPath();ctx.ellipse(x,y+2,w,7,0,0,Math.PI*2);ctx.fill();ctx.restore()}

let particles=[],splash=[],sinkTime=0,impactCooldown=0,windmillAngle=0;let vw=0,vh=0,dpr=1,sx=1,sy=1,last=0,acc=0,t=0,level=0,score=0,shots=0,mode='intro',aiming=false,pid=null,start={x:0,y:0},cursor={x:0,y:0},power=0,aimdir={x:1,y:-.3},wind=0,elapsed=0,restTime=0,transitionTimer=null,toastTimeout=null,audioCtx=null,sound=true,cameraShake=0,celebration=[],lastSafe={x:150,y:420},highScore=0;
try{highScore=+localStorage.getItem('pg-green-valley-best')||0}catch(e){}
const ball={x:160,y:418,vx:0,vy:0,angle:0,spin:0,grounded:true};
const levels=[
 {title:'Premier swing',wind:0,pts:[[0,465],[220,465],[410,475],[570,466],[740,475],[930,468],[1200,468]],cup:945,trees:[],water:[],rocks:[],bridges:[]},
 {title:'Le vent se lève',wind:1,pts:[[0,475],[215,475],[360,495],[500,473],[680,454],[845,478],[1200,470]],cup:950,trees:[],water:[],rocks:[],bridges:[]},
 {title:'La grande butte',wind:-1,pts:[[0,477],[190,477],[310,473],[440,432],[515,389],[620,429],[750,479],[890,467],[1200,469]],cup:958,trees:[],water:[],rocks:[],bridges:[]},
 {title:'Le premier lac',wind:0,pts:[[0,478],[300,478],[415,500],[540,506],[680,475],[930,468],[1200,467]],cup:966,trees:[],water:[[403,558]],rocks:[],bridges:[]},
 {title:'Le vieux chêne',wind:2,pts:[[0,480],[340,480],[475,494],[610,475],[900,475],[1200,472]],cup:977,trees:[{x:568,base:478,kind:'solid',s:1}],water:[],rocks:[],bridges:[]},
 {title:'La pente douce',wind:-2,pts:[[0,477],[220,477],[370,452],[460,416],[560,393],[670,413],[780,460],[950,472],[1200,468]],cup:974,trees:[],water:[],rocks:[{x:783,y:434,r:27}],bridges:[]},
 {title:'Entre les branches',wind:1,pts:[[0,474],[270,474],[410,479],[560,479],[720,471],[1200,472]],cup:974,trees:[{x:560,base:478,kind:'gate',s:1.1}],water:[],rocks:[],bridges:[]},
 {title:'Deux rives',wind:-1,pts:[[0,476],[260,476],[365,492],[500,503],[605,488],[700,479],[1200,472]],cup:975,trees:[],water:[[350,617]],rocks:[],bridges:[{x:423,y:436,w:110,h:13}]},
 {title:'Le roc',wind:2,pts:[[0,479],[250,479],[430,475],[555,488],[760,478],[940,476],[1200,471]],cup:973,trees:[],water:[],rocks:[{x:514,y:451,r:44},{x:800,y:454,r:30}],bridges:[]},
 {title:'Le tunnel vivant',wind:-2,pts:[[0,477],[225,477],[385,491],[600,483],[740,469],[920,477],[1200,473]],cup:977,trees:[{x:472,base:489,kind:'gate',s:1.2},{x:765,base:469,kind:'solid',s:.75}],water:[],rocks:[],bridges:[]},
 {title:'Les collines jumelles',wind:3,pts:[[0,480],[200,480],[340,445],[425,398],[550,473],[675,451],[760,406],[860,459],[990,479],[1200,476]],cup:1040,trees:[],water:[[520,615]],rocks:[],bridges:[]},
 {title:'Final de Green Valley',wind:-3,pts:[[0,476],[210,476],[350,489],[475,503],[590,476],[690,432],[785,450],[905,470],[1060,474],[1200,473]],cup:1070,trees:[{x:700,base:433,kind:'gate',s:.92}],water:[[373,567]],rocks:[{x:935,y:448,r:26}],bridges:[]}
];

// New obstacle families are intentionally introduced after the opening tutorial holes.
levels[7].bridges=[{x:348,y:469,w:269,h:14}];
levels[5].logs=[{x:700,y:438,w:85,r:11}];
levels[7].huts=[{x:730,y:407,w:73,h:69}];
levels[8].logs=[{x:625,y:440,w:108,r:11}];
levels[9].huts=[{x:1030,y:410,w:64,h:62}];
levels[10].mills=[{x:855,y:341,r:75}];
levels[11].mills=[{x:819,y:328,r:58}];
levels[11].logs=[{x:588,y:451,w:72,r:11}];
levels[5].title='Le sentier des géants';levels[7].title='Le pont du pêcheur';levels[8].title='La vallée des rochers';levels[9].title='La cabane du forestier';levels[10].title='Le moulin des collines';levels[11].title='Le grand défi de Green Valley';
const levelArt=[{"bg":"M2","back":"H1","sky":"day","decor":["C1"],"trees":["A1"],"rocks":["R1"],"flora":["F1","B1"]},{"bg":"M1","back":"H1","sky":"day","decor":["C1"],"trees":["A3"],"rocks":["R2"],"flora":["B2","F2"]},{"bg":"M2","back":"H2","sky":"day","decor":["C2"],"trees":["A4"],"rocks":["R3"],"flora":["B1","F3"]},{"bg":"M3","back":"H2","sky":"day","decor":["C1"],"trees":["A2"],"rocks":["R4"],"flora":["F3","B2"]},{"bg":"M1","back":"H1","sky":"day","decor":["C3"],"trees":["A1"],"rocks":["R2"],"flora":["B1","F4"]},{"bg":"M2","back":"H2","sky":"day","decor":["C2"],"trees":["A5"],"rocks":["R3"],"flora":["B3","F3"]},{"bg":"M1","back":"H3","sky":"day","decor":["C3"],"trees":["A3"],"rocks":["R4"],"flora":["F1","B2"]},{"bg":"M3","back":"H2","sky":"day","decor":["C1"],"trees":["A2"],"rocks":["R2"],"flora":["F2","B1"]},{"bg":"M4","back":"H2","sky":"sunset","decor":["C2"],"trees":["A5"],"rocks":["R5"],"flora":["B4","F4"]},{"bg":"M3","back":"H3","sky":"sunset","decor":["C3"],"trees":["A4"],"rocks":["R1"],"flora":["B3","F5"]},{"bg":"M2","back":"H2","sky":"sunset","decor":["C2"],"trees":["A3"],"rocks":["R4"],"flora":["B2","F3"]},{"bg":"M3","back":"H3","sky":"sunset","decor":["C2"],"trees":["A2"],"rocks":["R5"],"flora":["B4","F2"]}];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function cy(l,x){let p=l.pts;if(x<=p[0][0])return p[0][1];for(let i=1;i<p.length;i++){const a=p[i-1],b=p[i];if(x<=b[0]){let u=(x-a[0])/(b[0]-a[0]);u=u*u*(3-2*u);return a[1]+(b[1]-a[1])*u;}}return p[p.length-1][1]}
function slope(l,x){return (cy(l,x+2)-cy(l,x-2))/4}
function inWater(l,x){return l.water.some(w=>x>w[0]+7&&x<w[1]-7)}
function safeHeight(l,x){return cy(l,x)-R-.3}
function resize(){const rc=canvas.getBoundingClientRect();let cw=canvas.clientWidth,ch=canvas.clientHeight;dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.max(1,Math.round(cw*dpr));canvas.height=Math.max(1,Math.round(ch*dpr));vw=cw;vh=ch;sx=cw/MW;sy=ch/MH}
window.addEventListener('resize',resize,{passive:true});window.addEventListener('orientationchange',()=>setTimeout(resize,150));resize();
function pointFromEvent(e){let x,y;if(matchMedia('(orientation: portrait)').matches){x=e.clientY;y=window.innerWidth-e.clientX;}else{x=e.clientX;y=e.clientY;}return {x:x/sx,y:y/sy}}
function modal(tag,hero,title,desc,primary,fn,alt,altfn,extra){mode='modal';aiming=false;el('tag').textContent=tag;el('hero').textContent=hero;el('title').textContent=title;el('desc').innerHTML=desc;el('go').textContent=primary;el('go').onclick=()=>{el('overlay').classList.add('hidden');fn()};el('other').style.display=alt?'block':'none';if(alt){el('other').textContent=alt;el('other').onclick=()=>{el('overlay').classList.add('hidden');altfn()}}el('points').hidden=!extra;el('points').textContent=extra||'';el('small').textContent=level>=0?'Green Valley · 12 trous · Édition Atlas':'';el('overlay').classList.remove('hidden')}
function setLevel(i){el('menu').classList.add('hidden');el('overlay').classList.add('hidden');level=i;shots=0;power=0;wind=levels[i].wind===0?0:Math.sign(levels[i].wind)*[0,24,58,105][Math.abs(levels[i].wind)];let l=levels[i];ball.x=160;ball.y=safeHeight(l,160);ball.vx=ball.vy=ball.angle=ball.spin=0;ball.grounded=true;lastSafe={x:ball.x,y:ball.y};elapsed=0;restTime=0;mode='ready';celebration=[];particles=[];sinkTime=0}
function restart(){score=0;setLevel(0)}
function goHome(){aiming=false;mode='home';el('menu').classList.remove('level-view');el('overlay').classList.add('hidden');el('menu').classList.remove('hidden');el('menu').classList.remove('world-view')}
function goWorlds(){aiming=false;mode='worlds';el('menu').classList.remove('level-view');el('overlay').classList.add('hidden');el('menu').classList.remove('hidden');el('menu').classList.add('world-view')}
function goLevels(){aiming=false;mode='worlds';el('overlay').classList.add('hidden');el('menu').classList.remove('hidden');el('menu').classList.add('level-view');const grid=el('levelGrid');grid.innerHTML='';for(let i=0;i<levels.length;i++){let btn=document.createElement('button');btn.className='level-card';const medals=(holeBest[i]||0);btn.innerHTML=`<span class="num">${i+1}</span><span class="label">${levels[i].title}</span><span class="stars">${medals?'★'.repeat(medals)+'☆'.repeat(3-medals):'☆☆☆'}</span>`;btn.title=levels[i].title;btn.onclick=()=>{score=0;setLevel(i)};grid.append(btn)}}
const holeBest=Array(12).fill(0);try{const saved=JSON.parse(localStorage.getItem('pocket-golf-hole-best')||'null');if(Array.isArray(saved))saved.slice(0,12).forEach((x,i)=>holeBest[i]=Math.max(0,Math.min(3,+x||0)))}catch(_){ }
el('startMenu').onclick=goWorlds;el('menuBack').onclick=goHome;el('worldOne').onclick=goLevels;el('levelsBack').onclick=goWorlds;
function windMark(n){return n===0?'—':(n>0?'→':'←').repeat(Math.abs(n))}
function doToast(s){el('toast').textContent=s;el('toast').classList.add('show');clearTimeout(toastTimeout);toastTimeout=setTimeout(()=>el('toast').classList.remove('show'),1400)}
function onDown(e){if(mode!=='ready'||!el('overlay').classList.contains('hidden'))return;const p=pointFromEvent(e);if(p.y<81||p.x>MW-85)return;aiming=true;pid=e.pointerId;start=p;cursor=p;power=0;try{canvas.setPointerCapture(pid)}catch(_){}e.preventDefault()}
function onMove(e){if(!aiming||e.pointerId!==pid)return;cursor=pointFromEvent(e);const dx=start.x-cursor.x,dy=start.y-cursor.y,dist=Math.hypot(dx,dy);power=clamp(dist/MAX_DRAG,0,1);if(dist>2){aimdir.x=dx/dist;aimdir.y=dy/dist;}e.preventDefault()}
function onUp(e){if(!aiming||pid!==e.pointerId)return;onMove(e);aiming=false;pid=null;if(power<.065)return;const speed=Math.max(90,Math.pow(power,.86)*MAX_DRAG*SHOOT);ball.vx=aimdir.x*speed;ball.vy=aimdir.y*speed;ball.grounded=false;lastSafe={x:ball.x,y:ball.y};elapsed=0;restTime=0;shots++;mode='flying';emit(ball.x,ball.y,'swing',12);tone(240+power*220,.09);power=0;try{canvas.releasePointerCapture(e.pointerId)}catch(_){}e.preventDefault()}
canvas.addEventListener('pointerdown',onDown);canvas.addEventListener('pointermove',onMove);canvas.addEventListener('pointerup',onUp);canvas.addEventListener('pointercancel',()=>{aiming=false;pid=null;power=0});
function tone(f=300,d=.08){if(!sound)return;try{audioCtx ||=new(window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==='suspended')audioCtx.resume();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='sine';o.frequency.setValueAtTime(f,audioCtx.currentTime);g.gain.setValueAtTime(.055,audioCtx.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+d);o.connect(g).connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+d)}catch(e){}}
function collideNormal(nx,ny,restitution=.43,friction=.84){const len=Math.hypot(nx,ny)||1;nx/=len;ny/=len;let vn=ball.vx*nx+ball.vy*ny;if(vn>=0)return;let tx=ball.vx-vn*nx,ty=ball.vy-vn*ny;const impact=Math.abs(vn);const e=impact<78?0:restitution;ball.vx=tx*friction-vn*e*nx;ball.vy=ty*friction-vn*e*ny;if(impact>95&&impactCooldown<=0){emit(ball.x,ball.y,'rock',Math.min(16,Math.ceil(impact/42)));impactCooldown=.085}if(impact>165){cameraShake=Math.min(3,impact/320);tone(125+Math.min(130,impact/5),.045)}}
function circleObstacle(cx,cy,rad,restitution=.45){let dx=ball.x-cx,dy=ball.y-cy,dd=Math.hypot(dx,dy);const min=R+rad;if(dd>=min)return false;if(dd<.0001){dx=0;dy=-1;dd=1;}let nx=dx/dd,ny=dy/dd;ball.x=cx+nx*(min+.05);ball.y=cy+ny*(min+.05);collideNormal(nx,ny,restitution,.83);return true}
function segmentObstacle(ax,ay,bx,by,rad,restitution=.34){let vx=bx-ax,vy=by-ay;let q=clamp(((ball.x-ax)*vx+(ball.y-ay)*vy)/(vx*vx+vy*vy||1),0,1);return circleObstacle(ax+q*vx,ay+q*vy,rad,restitution)}
function solidBlock(x,y,w,h,elastic=.32){const px=clamp(ball.x,x,x+w),py=clamp(ball.y,y,y+h);let dx=ball.x-px,dy=ball.y-py,dist=Math.hypot(dx,dy);if(dist>=R)return;
 if(dist<.001){const choices=[{nx:-1,ny:0,dist:ball.x-x},{nx:1,ny:0,dist:x+w-ball.x},{nx:0,ny:-1,dist:ball.y-y},{nx:0,ny:1,dist:y+h-ball.y}].sort((a,b)=>a.dist-b.dist);const c=choices[0];ball.x+=c.nx*(c.dist+R+.2);ball.y+=c.ny*(c.dist+R+.2);collideNormal(c.nx,c.ny,elastic,.80);return;}
 const nx=dx/dist,ny=dy/dist;ball.x+=nx*(R-dist+.2);ball.y+=ny*(R-dist+.2);collideNormal(nx,ny,elastic,.82)}
function tree(tr){const sc=tr.s,x=tr.x,base=tr.base;
 const bark=(xx,yy,ww,hh)=>{const gr=ctx.createLinearGradient(xx,yy,xx+ww,yy);gr.addColorStop(0,'#5f361e');gr.addColorStop(.36,'#ad723f');gr.addColorStop(.7,'#a16736');gr.addColorStop(1,'#5e391d');rrect(xx-2*sc,yy-2*sc,ww+4*sc,hh+4*sc,5*sc,'#503b29');ctx.fillStyle=gr;ctx.fillRect(xx,yy,ww,hh);line(xx+ww*.34,yy+10*sc,xx+ww*.27,yy+hh*.8,2*sc,'#d0a075');line(xx+ww*.71,yy+12*sc,xx+ww*.66,yy+hh*.9,2*sc,'#73472a')};
 const canopy=(cx,cy,rx,ry,seed)=>{
  ctx.save();ctx.translate(cx,cy);const colors=['#0d633b','#167b36','#268e36','#39a743','#59b446','#77c849','#a6d65c','#bddb61'];
  for(let i=0;i<34;i++){const a=i*2.399+seed,r=Math.sqrt((i+.5)/34),xx=Math.cos(a)*rx*r,yy=Math.sin(a)*ry*r*.76;const rr=(12+((i*13)%17))*sc;let grad=ctx.createRadialGradient(xx-rr*.25,yy-rr*.4,1,xx,yy,rr);let col=colors[(i+(i>16?1:0))%colors.length];grad.addColorStop(0,'#c1e779');grad.addColorStop(.35,col);grad.addColorStop(1,i%3===0?'#1b793c':'#388d39');ctx.fillStyle=grad;ctx.beginPath();ctx.ellipse(xx,yy,rr,rr*.76,0,0,Math.PI*2);ctx.fill()}
  ctx.restore();
 };
 // Soft ground contact shadow integrates the prop into the fairway.
 ctx.fillStyle='#244d2c46';ctx.beginPath();ctx.ellipse(x,base+3*sc,58*sc,10*sc,0,0,Math.PI*2);ctx.fill();
 if(tr.kind==='solid'){
  bark(x-11*sc,base-95*sc,22*sc,95*sc);
  // Canopies correspond to the five clusters used by physical collision.
  canopy(x,base-126*sc,68*sc,60*sc,x*.01);
  canopy(x-9*sc,base-165*sc,50*sc,44*sc,x*.02);
  canopy(x+8*sc,base-99*sc,58*sc,39*sc,x*.03);
 }else{
  const w=118*sc,h=120*sc,top=base-h,lx=x-w/2,rx=x+w/2;
  bark(lx,top+34*sc,18*sc,h-34*sc);bark(rx-18*sc,top+34*sc,18*sc,h-34*sc);
  rrect(lx-8*sc,top-6*sc,w+16*sc,35*sc,11*sc,'#503b29');rrect(lx-3*sc,top,w+6*sc,24*sc,9*sc,'#95643c');
  canopy(x,top-46*sc,87*sc,57*sc,x*.02);canopy(x-18*sc,top-80*sc,57*sc,46*sc,x*.03);canopy(x+20*sc,top-79*sc,51*sc,40*sc,x*.01);
  // Illuminated opening below the canopy (nothing drawn into the passage).
  ctx.strokeStyle='#d0a16c';ctx.lineWidth=2.5*sc;ctx.beginPath();ctx.moveTo(lx+21*sc,top+35*sc);ctx.lineTo(lx+21*sc,base-4*sc);ctx.moveTo(rx-21*sc,top+35*sc);ctx.lineTo(rx-21*sc,base-4*sc);ctx.stroke();
 }
}
function polygonObstacle(points,restitution=.4){
 // Circle against convex polygon: nearest edge point; if ball is inside, resolve toward nearest boundary.
 let inside=true,insideSign=0,minDist=Infinity,bestX=0,bestY=0,bestNX=0,bestNY=-1;
 for(let i=0;i<points.length;i++){const a=points[i],b=points[(i+1)%points.length],dx=b[0]-a[0],dy=b[1]-a[1];const u=clamp(((ball.x-a[0])*dx+(ball.y-a[1])*dy)/(dx*dx+dy*dy),0,1);const px=a[0]+u*dx,py=a[1]+u*dy;const dd=Math.hypot(ball.x-px,ball.y-py);if(dd<minDist){minDist=dd;bestX=px;bestY=py;}
 const cross=dx*(ball.y-a[1])-dy*(ball.x-a[0]);if(i===0){insideSign=Math.sign(cross)}else if(cross*insideSign < -0.0001)inside=false;}
 if(!inside && minDist>=R)return;
 let nx=ball.x-bestX,ny=ball.y-bestY,d=Math.hypot(nx,ny);
 if(inside){nx=bestX-ball.x;ny=bestY-ball.y;d=Math.hypot(nx,ny);if(d<.001){nx=0;ny=-1;d=1}ball.x=bestX+nx/d*(R+.25);ball.y=bestY+ny/d*(R+.25);}
 else {if(d<.001){nx=0;ny=-1;d=1}ball.x=bestX+nx/d*(R+.25);ball.y=bestY+ny/d*(R+.25);}
 collideNormal(nx/d,ny/d,restitution,.86);
}
function treeCollisions(l){
 // Trunks and foliage are solid. Hollow arches have only solid side pillars and top canopy.
 for(const tr of l.trees){
  const z=tr.s, x=tr.x, base=tr.base;
  if(tr.kind==='solid'){
   solidBlock(x-11*z,base-94*z,22*z,95*z,.28);
   // Overlapping circular collision shapes approximate each triangular pine tier.
   const clusters=[
    {y:base-145*z,w:28*z},
    {y:base-123*z,w:40*z},
    {y:base-101*z,w:50*z},
    {y:base-80*z,w:58*z},
    {y:base-60*z,w:58*z}
   ];
   for(const c of clusters){
    // Use a wide, shallow ellipse approximation made of circles to keep the ball out of the leaves.
    const r=17*z;
    for(let j=-2;j<=2;j++) circleObstacle(x+j*c.w/3,c.y,r,.38);
   }
  }else{
   const w=118*z, h=120*z, top=base-h, left=x-w/2, right=x+w/2;
   solidBlock(left-4*z,top+34*z,24*z,h-24*z,.3);
   solidBlock(right-20*z,top+34*z,24*z,h-24*z,.3);
   // Solid canopy; the opening between the side pillars stays clear below it.
   solidBlock(left-8*z,top-7*z,w+16*z,37*z,.32);
   for(let j=-3;j<=3;j++){
    let nx=x+j*20*z;
    circleObstacle(nx,top-49*z+Math.abs(j)*9*z,20*z,.35);
   }
  }
 }
}
function obstacles(l){for(const h of (l.huts||[])){
 // Match the illustrated hut's roof and walls instead of using an invisible box
 // only around its lower half. The roof uses a sloped collision silhouette.
 polygonObstacle([[h.x-9,h.y+8],[h.x+h.w*.5,h.y-53],[h.x+h.w+9,h.y+8]],.32);
 solidBlock(h.x-6,h.y+6,h.w+12,h.h-6,.34);
 }for(const m of (l.mills||[])){circleObstacle(m.x,m.y,19,.46);for(let k=0;k<4;k++){const a=windmillAngle+k*Math.PI/2;segmentObstacle(m.x,m.y,m.x+Math.cos(a)*m.r,m.y+Math.sin(a)*m.r,6,.55)}}for(const log of(l.logs||[])){segmentObstacle(log.x,log.y,log.x+log.w,log.y,log.r||12,.40)}for(let r of l.rocks){circleObstacle(r.x,r.y,r.r,.38)}for(let b of l.bridges){solidBlock(b.x,b.y,b.w,b.h,.30)}treeCollisions(l)}
function hazard(msg='Hors limites !'){if(msg.includes('Plouf'))emit(ball.x,ball.y,'water',22);const l=levels[level];ball.x=160;ball.y=safeHeight(l,160);ball.vx=ball.vy=0;ball.grounded=true;restTime=0;elapsed=0;tone(145,.15);if(shots>=3){endHole(false)}else{mode='ready';doToast(msg+' · Retour au départ')}}
function endHole(success){if(mode==='ending'||mode==='modal')return;mode='ending';ball.vx=ball.vy=0;const earned=success?4-shots:0;score+=earned;if(earned>holeBest[level]){holeBest[level]=earned;try{localStorage.setItem('pocket-golf-hole-best',JSON.stringify(holeBest))}catch(e){}}clearTimeout(transitionTimer);if(success){tone(680,.14);for(let i=0;i<34;i++){const a=i*2.399,s=70+Math.random()*170;celebration.push({x:ball.x,y:ball.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-90,life:1+Math.random()*.6,r:3+Math.random()*4,col:['#f4c54a','#ff716b','#ffffff','#17c75d'][i%4]})}}
 transitionTimer=setTimeout(()=>{if(level===levels.length-1){if(score>highScore){highScore=score;try{localStorage.setItem('pg-green-valley-best',score)}catch(e){}}modal('Monde 1 terminé','🏆','GREEN VALLEY',`Tu as terminé les 12 trous avec <b>${score}/36 points</b> !<br>${score>=28?'Excellent ! Tu as atteint le seuil de 28 points.':'Objectif du monde : 28 points. Rejoue pour améliorer ton score.'}`, 'Rejouer le monde',restart,'Choix des mondes',goWorlds,()=>setLevel(level),`${score} / 36`)}else{const current=level;modal(success?'Trou réussi !':'Plus de coups','⛳',success?earned===3?'HOLE IN ONE !':`+${earned} POINT${earned>1?'S':''}`:'TROU MANQUÉ',success?`Balle rentrée en <b>${shots} coup${shots>1?'s':''}</b>. Total : <b>${score} pts</b>.`:`Tu as utilisé tes trois coups. Total : <b>${score} pts</b>.`,'Trou suivant →',()=>setLevel(current+1),'Rejouer ce trou',()=>setLevel(current),success?`+${earned}`:'0') }},success?820:430)
}
function step(dt){if(mode==='sinking'){sinkTime+=dt;ball.x+=(levels[level].cup-ball.x)*Math.min(1,dt*12);ball.y+=dt*45;if(sinkTime>.38){endHole(true)}return}if(mode!=='flying')return;const l=levels[level];elapsed+=dt;
 // Wind only acts in the air: one arrow mild, two moderate, three strong.
 if(!ball.grounded)ball.vx+=wind*dt;
 ball.vx*=1-.000065*Math.hypot(ball.vx,ball.vy)*dt;
 ball.vy+=G*dt;
 const oldx=ball.x,oldy=ball.y;
 ball.x+=ball.vx*dt;ball.y+=ball.vy*dt;ball.angle+=ball.vx*dt/R;
 if(ball.x< -48||ball.x>MW+48||ball.y>MH+75||ball.y< -240){hazard('Hors limites !');return}
 obstacles(l);
 // A generous, swept cup hit-test: crossing the cup on/near the green counts,
 // provided the ball is not travelling at extreme speed or high above the grass.
 const cupX=l.cup,cupY=cy(l,cupX);
 const segX=ball.x-oldx,alpha=Math.abs(segX)>0.01?clamp((cupX-oldx)/segX,0,1):0;
 const nearX=Math.abs(ball.x-cupX)<24 || (Math.min(oldx,ball.x)<=cupX+17 && Math.max(oldx,ball.x)>=cupX-17);
 const nearY=oldy+(ball.y-oldy)*alpha;
 const speed=Math.hypot(ball.vx,ball.vy);
 if(nearX && Math.min(Math.abs(ball.y-(cupY-R)),Math.abs(nearY-(cupY-R)))<23 && speed<650 && ball.vy>-175){mode='sinking';sinkTime=0;ball.vx=ball.vy=0;emit(cupX,cupY-6,'cup',20);tone(720,.12);return}
 const onWater=inWater(l,ball.x),g=cy(l,ball.x),m=slope(l,ball.x);
 if(onWater){const w=l.water.find(q=>ball.x>q[0]&&ball.x<q[1]);const waterY=Math.max(cy(l,w[0]),cy(l,w[1]))+13;if(ball.y+R>=waterY){hazard('Plouf !');return}}
 else if(ball.y+R>=g){
 let nx=m,ny=-1;let len=Math.hypot(nx,ny);nx/=len;ny/=len;
 // correct penetration along surface normal, retain tangential velocity
 const depth=ball.y+R-g;ball.x+=nx*Math.min(4,depth*.3);ball.y=cy(l,ball.x)-R;
 const vn=ball.vx*nx+ball.vy*ny;
 if(vn< -68){if(Math.abs(vn)>90&&impactCooldown<=0){emit(ball.x,g-5,'grass',11);impactCooldown=.09}collideNormal(nx,ny,.38,.89)}else{
 const tx=1/len,ty=m/len,along=ball.vx*tx+ball.vy*ty;
 let next=along+G*ty*dt;const resist=125*dt;
 if(Math.abs(next)<resist && Math.abs(G*ty)<125){next=0}else next-=Math.sign(next)*Math.min(resist,Math.abs(next));
 ball.vx=tx*next;ball.vy=ty*next;
 }
 ball.grounded=true;
 }else ball.grounded=false;
 const cupx=l.cup,cupy=cy(l,cupx);
 if(Math.abs(ball.x-cupx)<26&&ball.y+R>=cupy-18&&ball.y+R<=cupy+22&&Math.hypot(ball.vx,ball.vy)<650){mode='sinking';sinkTime=0;ball.vx=ball.vy=0;emit(cupx,cupy-6,'cup',20);tone(720,.12);return}
 if(ball.grounded&&Math.hypot(ball.vx,ball.vy)<12)restTime+=dt;else restTime=0;
 if(restTime>.55||elapsed>14){ball.vx=ball.vy=0;ball.y=safeHeight(l,ball.x);ball.grounded=true;mode='ready';restTime=0;if(shots>=3)endHole(false);else doToast('À toi de jouer !')}
}

function emit(x,y,kind='grass',number=8){const cols={grass:['#d6f181','#71c953','#438f40','#fff4ae'],wood:['#f5cc8a','#b77745','#855037'],rock:['#d4e4e4','#91b0bc','#64848b'],water:['#dcfdff','#a6ecff','#49c0f2'],swing:['#ffef99','#fffdfa','#b5ef8e'],cup:['#ffe37e','#ffffff','#ff92ad','#91ee9c']}[kind]||['#fff'];for(let j=0;j<number;j++){const a=(j/number)*6.283+(Math.random()-.5),sp=30+Math.random()*165;particles.push({x,y,vx:Math.cos(a)*sp,vy:Math.sin(a)*sp-60,r:2+Math.random()*3.5,life:.34+Math.random()*.42,max:.75,col:cols[j%cols.length],kind})}}
function drawParticles(dt){for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.life-=dt;if(p.life<=0){particles.splice(i,1);continue}p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=(p.kind==='water'?300:540)*dt;p.vx*=.992;ctx.save();ctx.globalAlpha=Math.min(1,p.life*2.3);ctx.fillStyle=p.col;ctx.beginPath();ctx.arc(p.x,p.y,p.r*Math.min(1,p.life*3),0,Math.PI*2);ctx.fill();ctx.restore()}}
function additionalObjects(){
 const l=levels[level];
 for(let i=0;i<(l.logs||[]).length;i++){const o=l.logs[i];drawAsset('O4',o.x+o.w/2,o.y+o.r+1,o.w+20,49)}
 for(let i=0;i<(l.huts||[]).length;i++){const o=l.huts[i];drawAsset('C3',o.x+o.w/2,o.y+o.h+5,o.w+45,o.h+77)}
 for(let i=0;i<(l.mills||[]).length;i++){const o=l.mills[i];drawAsset('C2',o.x,cy(l,o.x)+12,160,210);}
 // Only a couple of small plants: foreground remains readable. No unmarked solid obstacles.
 const a=levelArt[level];
 for(let j=0;j<7;j++){
 const x=260+j*131+(level%3)*14;
 if(x>l.cup-56||x<190||inWater(l,x))continue;
 if(l.trees.some(q=>Math.abs(q.x-x)<80)||l.rocks.some(q=>Math.abs(q.x-x)<60))continue;
 const kind=a.flora[j%a.flora.length];const y=cy(l,x)+4;
 ctx.save();ctx.globalAlpha=.91;drawAsset(kind,x,y,27+(j%3)*5,22+(j%2)*4);ctx.restore();
 }
}
function path(points,fill){ctx.beginPath();ctx.moveTo(points[0][0],points[0][1]);for(let i=1;i<points.length;i++)ctx.lineTo(points[i][0],points[i][1]);ctx.closePath();ctx.fillStyle=fill;ctx.fill()}
function rrect(x,y,w,h,r,c){ctx.fillStyle=c;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
function line(x1,y1,x2,y2,width,color){ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.lineWidth=width;ctx.lineCap='round';ctx.strokeStyle=color;ctx.stroke()}
function cloud(x,y,sc=1){ctx.save();ctx.translate(x,y);ctx.scale(sc,sc);ctx.globalAlpha=.62;ctx.shadowColor='#fff';ctx.shadowBlur=13;for(const [a,b,r] of [[-38,5,25],[-12,-7,32],[19,1,26],[45,8,18]]){ctx.fillStyle='#fffdf1';ctx.beginPath();ctx.arc(a,b,r,0,Math.PI*2);ctx.fill()}ctx.restore()}
function ambiance(){for(let k=0;k<7;k++){const x=(k*207+Math.sin(t*.35+k)*43+MW)%MW,y=250+k*19+Math.sin(t*1.2+k)*6;ctx.save();ctx.globalAlpha=.3;ctx.fillStyle=k%2?'#fffed0':'#faffd5';ctx.beginPath();ctx.arc(x,y,2.5+Math.sin(t*3+k)*.7,0,6.3);ctx.fill();ctx.restore()}}
function background(){
 const samples=['AMB2','AMB2','AMB1','AMB1','AMB2','AMB2','AMB1','AMB2','AMB3','AMB3','AMB5','AMB5'];
 const im=atlas[samples[level]];
 if(im&&im.complete&&im.naturalWidth){
  // One consistent original Green Valley illustration serves as a distant scene,
  // while all *interactive* geometry is drawn separately in exactly the same atlas palette.
  ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';ctx.drawImage(im,0,0,MW,490);
 }else{let gg=ctx.createLinearGradient(0,0,0,MH);gg.addColorStop(0,'#71caf4');gg.addColorStop(.7,'#b9eedb');gg.addColorStop(1,'#8acb8e');ctx.fillStyle=gg;ctx.fillRect(0,0,MW,MH)}
 // Far-layer softness and perspective subtly link illustrated scene to the playable terrain.
 const haze=ctx.createLinearGradient(0,260,0,525);haze.addColorStop(0,'#d0f8e500');haze.addColorStop(.45,'#d8f2e61f');haze.addColorStop(1,'#a1dbab99');ctx.fillStyle=haze;ctx.fillRect(0,260,MW,265);
 // Ambient moving clouds, but never overlay the player-facing ground.
 for(let i=0;i<3;i++){const x=((i*438+123+t*(5+i*1.6))%(MW+200))-110,y=68+i*34;
  const cloud=atlas['N'+(i+1)];if(cloud&&cloud.complete&&cloud.naturalWidth){ctx.save();ctx.globalAlpha=.50;ctx.drawImage(cloud,x,y,155+i*35,54+i*9);ctx.restore()}}
 // A few translucent tiny drifting leaves at the edges, kept off the ball's path.
 for(let j=0;j<4;j++){const x=(j*382+120+Math.sin(t*.6+j)*22)%MW,y=340+Math.sin(t*1.1+j)*8;
  ctx.save();ctx.globalAlpha=.30;ctx.translate(x,y);ctx.rotate(Math.sin(t+j));ctx.fillStyle='#98cf58';ctx.beginPath();ctx.ellipse(0,0,5,2,0,0,6.283);ctx.fill();ctx.restore()}
}

function terrain(){
 const l=levels[level],y0=cy(l,0);
 // One single continuous soil silhouette; water is carved out before grass is applied.
 ctx.beginPath();ctx.moveTo(0,y0);for(let x=4;x<=MW;x+=4)ctx.lineTo(x,cy(l,x));ctx.lineTo(MW,MH+20);ctx.lineTo(0,MH+20);ctx.closePath();
 const earth=ctx.createLinearGradient(0,405,0,655);earth.addColorStop(0,'#db935a');earth.addColorStop(.28,'#c67d48');earth.addColorStop(.75,'#a25f3e');earth.addColorStop(1,'#814b38');ctx.fillStyle=earth;ctx.fill();
 ctx.save();ctx.clip();
 // Painterly strata, not the flat red slabs of old prototypes.
 for(let k=0;k<5;k++){ctx.beginPath();ctx.moveTo(0,cy(l,0)+23+k*40);for(let x=0;x<=MW;x+=12)ctx.lineTo(x,cy(l,x)+23+k*40+Math.sin(x/73+k*1.42)*7+Math.cos(x/38+k)*2);ctx.lineTo(MW,MH+20);ctx.lineTo(0,MH+20);ctx.closePath();ctx.fillStyle=['#e0a66f','#d3925b','#bb784b','#ad6946','#8f533b'][k];ctx.globalAlpha=k===0?.39:.22;ctx.fill();}ctx.globalAlpha=1;
 // Warm speckles and pebbles; deterministic so they stay still while playing.
 for(let j=0;j<285;j++){let x=(j*7919%1199)+.5,y=cy(l,x)+18+(j*1777%164);if(y>MH)continue;const r=1+(j%5)*.6;ctx.fillStyle=j%4===0?'#e2b982':j%4===1?'#7e5034':j%4===2?'#d49a61':'#a66a3d';ctx.globalAlpha=.26+(j%3)*.1;ctx.beginPath();ctx.ellipse(x,y,r*1.8,r,((j%11)-5)*.12,0,Math.PI*2);ctx.fill();}ctx.globalAlpha=1;
 
 // Large, softly cel-shaded earth stones, drawn INSIDE the soil clipping mask.
 for(let j=0;j<34;j++){
  const x=(j*211+83)%MW,y=cy(l,x)+38+(j*47)%130,r=6+(j%5)*3.5;
  ctx.fillStyle=j%3===0?'#a35b3d':j%3===1?'#d79562':'#ad6c46';
  ctx.beginPath();ctx.moveTo(x-r,y);ctx.lineTo(x-r*.67,y-r*.7);ctx.lineTo(x+r*.32,y-r*.9);ctx.lineTo(x+r,y-r*.15);ctx.lineTo(x+r*.72,y+r*.42);ctx.lineTo(x-r*.65,y+r*.58);ctx.closePath();ctx.fill();
  ctx.fillStyle=j%2?'#f0b7808a':'#e7a46a7b';ctx.beginPath();ctx.moveTo(x-r*.67,y-r*.55);ctx.lineTo(x+r*.22,y-r*.76);ctx.lineTo(x+r*.13,y-r*.13);ctx.lineTo(x-r*.81,y+.05*r);ctx.closePath();ctx.fill();
 }
 // The roots of gameplay trees continue below the grass, making the trees feel planted.
 for(const tr of l.trees){const x=tr.x,y=cy(l,x);
  ctx.beginPath();ctx.moveTo(x-3,y-3);ctx.bezierCurveTo(x-12,y+21,x-24,y+28,x-33,y+39);ctx.moveTo(x+3,y);ctx.bezierCurveTo(x+15,y+22,x+19,y+30,x+40,y+37);
  ctx.strokeStyle='#80503db2';ctx.lineWidth=5*tr.s;ctx.lineCap='round';ctx.stroke();
 }
ctx.restore();
 // Carved ponds, banks and surface in the same earth silhouette.
 for(const [a,b] of l.water){const ya=cy(l,a),yb=cy(l,b),top=Math.min(ya,yb)-1;
   ctx.beginPath();ctx.moveTo(a-9,ya-2);ctx.quadraticCurveTo(a+15,top+13,a+26,top+12);ctx.lineTo(b-26,top+12);ctx.quadraticCurveTo(b-15,top+13,b+9,yb-2);ctx.lineTo(b+9,MH+20);ctx.lineTo(a-9,MH+20);ctx.closePath();ctx.fillStyle='#184b6c';ctx.fill();
   ctx.beginPath();ctx.moveTo(a-3,ya+1);ctx.quadraticCurveTo(a+20,top+12,a+29,top+13);ctx.lineTo(b-29,top+13);ctx.quadraticCurveTo(b-20,top+12,b+3,yb+1);ctx.lineTo(b+3,MH+20);ctx.lineTo(a-3,MH+20);ctx.closePath();ctx.save();ctx.clip();
   let waterGrad=ctx.createLinearGradient(0,top,0,top+145);waterGrad.addColorStop(0,'#81eff7');waterGrad.addColorStop(.26,'#20b8eb');waterGrad.addColorStop(1,'#1277b4');ctx.fillStyle=waterGrad;ctx.fillRect(a-12,top,b-a+24,MH-top+20);ctx.restore();
 }
 // Banks meet grass and soil naturally: small mossy stones and roots visually
 // bridge the waterline instead of making water look like a pasted rectangle.
 for(const [a,b] of l.water){
  for(const edge of [a,b]){
   const yy=cy(l,edge);
   ctx.save();ctx.globalAlpha=.9;
   for(let i=0;i<3;i++){
    const xx=edge+(edge===a?-1:1)*(7+i*10);
    const h=5+i*1.7;
    ctx.fillStyle=i%2?'#827d79':'#a7a09a';
    ctx.beginPath();ctx.ellipse(xx,yy+5+i*.7,8+i*2,h,0,Math.PI,Math.PI*2);ctx.fill();
    ctx.fillStyle='#b8d78b';ctx.beginPath();ctx.ellipse(xx-2,yy+1,4+i,1.8,0,0,Math.PI*2);ctx.fill();
   }
   ctx.restore();
  }
 }
 // Multilayer grass edge with a readable contact line.
 for(const [a,b] of solidRanges(l)){
  ctx.beginPath();ctx.moveTo(a,cy(l,a));for(let x=a+3;x<b;x+=3)ctx.lineTo(x,cy(l,x));ctx.lineTo(b,cy(l,b));ctx.lineJoin='round';ctx.lineCap='round';ctx.strokeStyle='#417a2e';ctx.lineWidth=25;ctx.stroke();ctx.strokeStyle='#4ca532';ctx.lineWidth=20;ctx.stroke();ctx.strokeStyle='#80cf36';ctx.lineWidth=15;ctx.stroke();ctx.strokeStyle='#d2f46a';ctx.lineWidth=4.5;ctx.stroke();
 }
 // Blades, little blooms and ambient contact shadows.
 for(let j=0;j<110;j++){let x=(j*1277+61)%MW;if(inWater(l,x))continue;let y=cy(l,x)-9;ctx.strokeStyle=j%3===0?'#e6f68b':j%3===1?'#4ea93d':'#80dc47';ctx.lineWidth=1+(j%3)*.3;ctx.beginPath();ctx.moveTo(x,y+4);ctx.quadraticCurveTo(x+((j%5)-2)*2,y-2-(j%4)*2,x+((j%7)-3)+Math.sin(t*1.4+j)*2,y-4-(j%4)*2);ctx.stroke();if(j%19===0){ctx.fillStyle='#ffffff';for(let p=0;p<5;p++){let ang=p*Math.PI*2/5;ctx.beginPath();ctx.arc(x+Math.cos(ang)*4,y-6+Math.sin(ang)*4,2,0,Math.PI*2);ctx.fill()}ctx.fillStyle='#f4cd45';ctx.beginPath();ctx.arc(x,y-6,2,0,Math.PI*2);ctx.fill()}}
}
function solidRanges(l){let ranges=[],from=0;for(const [a,b] of l.water){ranges.push([from,Math.max(from,a-7)]);from=Math.min(MW,b+7)}ranges.push([from,MW]);return ranges.filter(q=>q[1]>q[0]);}
function water(){const l=levels[level];for(const [a,b] of l.water){const top=Math.min(cy(l,a),cy(l,b))+11;ctx.save();ctx.beginPath();ctx.rect(a+13,top,b-a-26,57);ctx.clip();for(let k=0;k<4;k++){ctx.beginPath();for(let x=a+15;x<b-13;x+=5){let y=top+9+k*10+Math.sin(x*.055+t*(1+k*.15)+k)*2;if(x===a+15)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.strokeStyle=k===0?'#eeffffbd':'#79e7f6a3';ctx.lineWidth=k===0?2.8:1.8;ctx.stroke()}ctx.restore();
 // Foam and bank shading are aligned with actual water collision bounds.
 ctx.save();ctx.globalAlpha=.22;ctx.fillStyle='#deffff';ctx.beginPath();ctx.ellipse((a+b)/2,top+16,(b-a)*.35,6,0,0,6.283);ctx.fill();ctx.restore();
 }}

function tree(tr){
 const code=tr.kind==='gate'?'O5':(['A1','A2','A3','A4','A5'][(level*3+Math.floor(tr.x/80))%5]);
 const base=cy(levels[level],tr.x)+1;
 const h=tr.kind==='gate'?160*tr.s:194*tr.s;
 const w=tr.kind==='gate'?167*tr.s:188*tr.s;
 groundShadow(tr.x,base,w*.30);
 ctx.save();ctx.translate(tr.x,base);ctx.rotate(Math.sin(t*.9+tr.x*.03)*.006);drawAsset(code,0,0,w,h);ctx.restore();
 // Roots and greenery in front of each tree share the playable grass color and hide the seam.
 for(let i=-2;i<=2;i++){ctx.fillStyle=i%2?'#7ecb42':'#9cdc52';ctx.beginPath();ctx.ellipse(tr.x+i*15,base-3,16,5,0,0,6.283);ctx.fill()}
}
function rocksAndBridges(){
 const l=levels[level],a=levelArt[level];
 for(let i=0;i<l.rocks.length;i++){const r=l.rocks[i];let code=['R1','R2','R3','R4','R5'][(level+i*2)%5];let wid=Math.max(52,r.r*2.8),hei=Math.max(40,r.r*2.3);drawAsset(code,r.x,r.y+r.r*.78,wid,hei)}
 for(let i=0;i<l.bridges.length;i++){const b=l.bridges[i];drawAsset(i%2?'P2':'P1',b.x+b.w/2,b.y+b.h+5,b.w+38,72)}
}
function flag(){const l=levels[level],x=l.cup,y=cy(l,x);ctx.fillStyle='#243c2944';ctx.beginPath();ctx.ellipse(x,y+5,24,7,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#23372a';ctx.beginPath();ctx.ellipse(x,y-1,18,4,0,0,Math.PI*2);ctx.fill();line(x+11,y,x+11,y-90,4,'#f6f6ef');ctx.fillStyle='#f25852';ctx.beginPath();ctx.moveTo(x+12,y-89);ctx.quadraticCurveTo(x-7,y-98+Math.sin(t*4)*5,x-41+Math.sin(t*3)*5,y-82+Math.sin(t*3)*7);ctx.quadraticCurveTo(x-10,y-71+Math.sin(t*4)*5,x+12,y-65);ctx.closePath();ctx.fill();ctx.lineWidth=2;ctx.strokeStyle='#de5750';ctx.stroke()}

function drawBall(){const l=levels[level],yy=cy(l,ball.x);ctx.save();ctx.fillStyle='#163d3866';ctx.beginPath();ctx.ellipse(ball.x+1,yy+6,16,4,0,0,Math.PI*2);ctx.fill();ctx.translate(ball.x,ball.y);ctx.rotate(ball.angle);let squish=mode==='sinking'?Math.max(.25,1-sinkTime*2.6):ball.grounded&&mode==='flying'?1+Math.sin(t*27)*.025:1;ctx.scale(1+(1-squish)*.25,squish);let gr=ctx.createRadialGradient(-5,-6,1,0,0,R+2);gr.addColorStop(0,'#ffffff');gr.addColorStop(.58,'#f6fdff');gr.addColorStop(1,'#b0d0d8');ctx.fillStyle=gr;ctx.beginPath();ctx.arc(0,0,R,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#e0f7f6';ctx.lineWidth=1.3;ctx.stroke();ctx.fillStyle='#8caeac77';for(const [px,py] of [[-3,-3],[4,-1],[0,5]]){ctx.beginPath();ctx.arc(px,py,1.6,0,Math.PI*2);ctx.fill()}ctx.restore()}

function drawnAim(){if(!aiming||mode!=='ready')return;const dx=start.x-cursor.x,dy=start.y-cursor.y,len=Math.hypot(dx,dy),p=clamp(len/MAX_DRAG,0,1);if(len<2)return;const ux=dx/len,uy=dy/len;
 // Straight aiming line IN THE SHOOTING DIRECTION; pull goes the opposite way.
 line(ball.x+ux*16,ball.y+uy*16,ball.x+ux*185,ball.y+uy*185,5,'#ffffffd9');
 line(ball.x+ux*16,ball.y+uy*16,ball.x+ux*(35+p*110),ball.y+uy*(35+p*110),10,'#ffffff');
 // back-drag power strip, translucent track and solid orange fill
 line(ball.x-ux*19,ball.y-uy*19,ball.x-ux*145,ball.y-uy*145,17,'#24576850');
 line(ball.x-ux*19,ball.y-uy*19,ball.x-ux*(19+p*126),ball.y-uy*(19+p*126),11,p>.84?'#ff6a5b':'#ffca56');
 ctx.fillStyle='#ffffff';ctx.font='900 17px system-ui';ctx.textAlign='center';ctx.fillText(Math.round(p*100)+'%',ball.x-ux*73,ball.y-uy*73-22);ctx.textAlign='start'
}
function roundHud(){
 const panel=(x,y,w,h)=>{ctx.save();ctx.shadowColor='#143d4c66';ctx.shadowBlur=11;ctx.shadowOffsetY=4;rrect(x,y,w,h,17,'#183d55db');ctx.shadowColor='transparent';ctx.lineWidth=1.6;ctx.strokeStyle='#ffffffaa';ctx.beginPath();ctx.roundRect(x,y,w,h,17);ctx.stroke();ctx.restore()};
 panel(20,17,228,55);ctx.fillStyle='#fff';ctx.font='900 20px system-ui';ctx.fillText(`⛳ Trou ${level+1} / 12`,34,43);ctx.font='700 13px system-ui';ctx.fillStyle='#daebef';ctx.fillText(`${score} points  ·  3 max`,75,61);
 panel(464,17,272,54);ctx.font='900 25px system-ui';ctx.fillStyle='#fff';ctx.textAlign='center';ctx.fillText(levels[level].wind===0?'Pas de vent':windMark(levels[level].wind),600,53);ctx.textAlign='left';
 panel(917,17,195,54);ctx.fillStyle='#fff';ctx.font='850 19px system-ui';ctx.fillText(`Coups : ${shots}`,934,51);
 panel(1130,17,50,54);ctx.fillStyle='#fff';ctx.font='900 27px system-ui';ctx.fillText('Ⅱ',1143,51);
 if(aiming){ctx.save();ctx.shadowColor='#143d4c77';ctx.shadowBlur=12;rrect(419,555,362,39,19,'#163e55c9');ctx.shadowColor='transparent';let gr=ctx.createLinearGradient(427,0,772,0);gr.addColorStop(0,'#5ae944');gr.addColorStop(.45,'#f7e451');gr.addColorStop(.8,'#ff923d');gr.addColorStop(1,'#f45256');rrect(426,563,348*power,23,10,gr);ctx.strokeStyle='#ffffffaa';ctx.lineWidth=1.5;ctx.beginPath();ctx.roundRect(419,555,362,39,19);ctx.stroke();ctx.restore();}
 else if(mode==='ready'){ctx.fillStyle='#fff9';ctx.font='750 15px system-ui';ctx.textAlign='center';ctx.fillText('Glisse en arrière pour tirer',600,591);ctx.textAlign='left'}
}
function drawCelebration(dt){for(const p of celebration){p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=G*.55*dt;p.life-=dt;ctx.globalAlpha=clamp(p.life,0,1);ctx.fillStyle=p.col;ctx.fillRect(p.x,p.y,p.r,p.r)}ctx.globalAlpha=1;celebration=celebration.filter(p=>p.life>0)}
function render(dt){ctx.setTransform(dpr*sx,0,0,dpr*sy,0,0);ctx.fillStyle='#86e2f2';ctx.fillRect(0,0,MW,MH);ctx.save();if(cameraShake>.02){ctx.translate((Math.random()-.5)*cameraShake,(Math.random()-.5)*cameraShake);cameraShake*=.86}background();terrain();water();rocksAndBridges();additionalObjects();for(const tr of levels[level].trees)tree(tr);flag();drawBall();drawnAim();drawCelebration(dt);drawParticles(dt);ctx.restore();if(!['home','worlds'].includes(mode))roundHud()}
function loop(ms){if(!last)last=ms;const dt=Math.min(.05,(ms-last)/1000);last=ms;t+=dt;windmillAngle+=dt*.85;impactCooldown=Math.max(0,impactCooldown-dt);acc=Math.min(.08,acc+dt);while(acc>=STEP){step(STEP);acc-=STEP}render(dt);requestAnimationFrame(loop)}
canvas.addEventListener('click',e=>{let p=pointFromEvent(e);if(p.x>1100&&p.y>12&&p.y<70&&mode!=='intro'&&mode!=='modal'){(()=>{const resumeMode=mode;modal('Pause','⛳','PAUSE',`Trou ${level+1} sur 12. Score actuel : <b>${score} pts</b>.`,'Continuer',()=>{mode=resumeMode},'Choix des mondes',goWorlds)})()}});
setLevel(0);goHome();requestAnimationFrame(loop);
})();
</script></body></html>
