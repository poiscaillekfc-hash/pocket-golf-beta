<body><div id="app"><canvas id="game" aria-label="Jeu de golf 2D. Tirez depuis la balle et relâchez pour lancer."></canvas>
<div class="hud"><div class="stats"><div class="pill stat"><div class="label">Parcours</div><div class="value" id="holeText">1 / 6</div></div><div class="pill stat"><div class="label">Coups</div><div class="value" id="shotsText">0 / 3</div></div><div class="pill stat"><div class="label">Score</div><div class="value" id="scoreText">0 pts</div></div></div><div class="pill stat wind"><div class="label">Vent</div><div class="value" id="windText">→ 0</div></div></div>
<div id="toast" class="toast"></div>
<div class="controls"><div class="hint" id="hint">👆 Tire depuis la balle vers l'arrière, puis relâche pour frapper.</div><div style="display:flex;gap:7px;flex-direction:column"><button class="btn secondary" id="soundBtn" type="button">🔊 Son</button><button class="btn" id="resetBtn" type="button">↻ Recommencer</button></div></div>
<div id="overlay" class="overlay"><div class="modal"><div class="tag" id="modalTag">Prototype jouable · V0.1</div><div class="hero" id="modalHero">⛳</div><h1 id="modalTitle">POCKET GOLF</h1><p id="modalDesc">6 trous, 3 coups maximum par trou. Glisse ton doigt <b>derrière la balle</b> pour régler l'angle et la puissance, puis relâche ! Attention au vent.</p><div id="modalExtra"></div><button class="primary" id="modalBtn" type="button">Jouer maintenant →</button></div></div>
</div>
<script>
(()=>{
'use strict';
const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');
const $=id=>document.getElementById(id);
const ui={hole:$('holeText'),shots:$('shotsText'),score:$('scoreText'),wind:$('windText'),hint:$('hint'),overlay:$('overlay'),tag:$('modalTag'),hero:$('modalHero'),title:$('modalTitle'),desc:$('modalDesc'),extra:$('modalExtra'),btn:$('modalBtn'),toast:$('toast')};
let W=1000,H=620,dpr=1,scale=1,ox=0,oy=0,groundBase=475, current=0,strokes=0,total=0,state='intro',dragging=false,drag={x:0,y:0},pointerId=null,stillTimer=0,afterShot=0,particles=[],clouds=[],sound=true,windPhase=0,elapsed=0,last=0,toastTimer=0;
const BALL_R=11, GRAVITY=950, MAX_PULL=120, SHOOT_FACTOR=7.6;
const courses=[
 {name:'Premiers pas',sky:['#9de5fc','#e1f8ff'],wind:0.3,holeX:825,pts:[[0,450],[170,450],[340,470],[530,472],[690,450],[1000,450]],bumpers:[],startX:110},
 {name:'Vent de face',sky:['#8ccff2','#d9f8fe'],wind:-2.3,holeX:840,pts:[[0,452],[195,451],[330,464],[480,485],[620,458],[750,455],[1000,455]],bumpers:[],startX:105},
 {name:'Le petit canyon',sky:['#98d9ef','#f8e2bc'],wind:1.25,holeX:848,pts:[[0,445],[250,445],[310,465],[380,520],[460,520],[560,447],[700,450],[1000,450]],bumpers:[],startX:110},
 {name:'Le rocher',sky:['#8ccef1','#f5f4df'],wind:-1.0,holeX:865,pts:[[0,455],[260,455],[390,457],[490,455],[660,449],[1000,449]],bumpers:[{x:490,y:404,w:42,h:51}],startX:110},
 {name:'Double dune',sky:['#91d9f7','#ffe1aa'],wind:2.9,holeX:885,pts:[[0,462],[180,462],[315,410],[390,430],[550,481],[680,405],[765,432],[1000,465]],bumpers:[],startX:100},
 {name:'Dernier défi',sky:['#95c5f6','#ffe4cb'],wind:-2.75,holeX:870,pts:[[0,465],[220,465],[350,486],[450,470],[590,395],[685,420],[760,466],[1000,460]],bumpers:[{x:430,y:430,w:28,h:41}],startX:100}
];
let ball={x:110,y:430,vx:0,vy:0,rest:true},hole={x:825,y:450};
function terrain(x){let pts=courses[current].pts;if(x<=pts[0][0])return pts[0][1];for(let i=1;i<pts.length;i++){if(x<=pts[i][0]){let a=pts[i-1],b=pts[i],t=(x-a[0])/(b[0]-a[0]);t=t*t*(3-2*t);return a[1]+(b[1]-a[1])*t}}return pts[pts.length-1][1]}
function slope(x){return (terrain(Math.min(1000,x+3))-terrain(Math.max(0,x-3)))/6}
function updateHUD(){ui.hole.textContent=`${current+1} / ${courses.length}`;ui.shots.textContent=`${strokes} / 3`;ui.score.textContent=`${total} pts`;let w=courses[current].wind;ui.wind.textContent=(Math.abs(w)<.5?'—':w>0?'→':'←')+' '+Math.round(Math.abs(w)*8)+' km/h';ui.hint.textContent=state==='flying'?'⛳ Observe la trajectoire de ta balle.':strokes>=3?'Fin des tentatives.':'👆 Tire depuis la balle vers l’arrière, puis relâche pour frapper.'}
function setCourse(index){current=index;strokes=0;dragging=false;stillTimer=0;afterShot=0;let c=courses[index];ball={x:c.startX,y:terrain(c.startX)-BALL_R,vx:0,vy:0,rest:true};hole={x:c.holeX,y:terrain(c.holeX)};particles=[];state='ready';updateHUD()}
function openModal(tag,hero,title,desc,btn,action,extra=''){ui.tag.textContent=tag;ui.hero.textContent=hero;ui.title.textContent=title;ui.desc.innerHTML=desc;ui.extra.innerHTML=extra;ui.btn.textContent=btn;ui.btn.onclick=()=>{ui.overlay.classList.add('hidden');action()};ui.overlay.classList.remove('hidden')}
function start(){total=0;setCourse(0);ui.overlay.classList.add('hidden');updateHUD()}
openModal('Prototype jouable · V0.1','⛳','POCKET GOLF','<b>6 trous · 3 coups par trou</b><br>Pose ton doigt sur la balle, tire vers l’arrière comme avec un lance-pierre et relâche. Vise le trou en tenant compte du vent !','C’est parti →',start);
function resize(){let rect=canvas.getBoundingClientRect();dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(rect.width*dpr);canvas.height=Math.round(rect.height*dpr);let rx=canvas.width/dpr,ry=canvas.height/dpr;scale=Math.min(rx/1000,ry/620);ox=(rx-1000*scale)/2;oy=(ry-620*scale)/2;W=rx;H=ry}
window.addEventListener('resize',resize);resize();
function worldPos(ev){let r=canvas.getBoundingClientRect();return{x:((ev.clientX-r.left)-ox)/scale,y:((ev.clientY-r.top)-oy)/scale}}
function onDown(ev){if(state!=='ready'||!ball.rest||!ui.overlay.classList.contains('hidden'))return;let p=worldPos(ev);if(Math.hypot(p.x-ball.x,p.y-ball.y)<85){dragging=true;pointerId=ev.pointerId;drag=p;canvas.setPointerCapture(ev.pointerId);ev.preventDefault()}}
function onMove(ev){if(!dragging||ev.pointerId!==pointerId)return;drag=worldPos(ev);ev.preventDefault()}
function onUp(ev){if(!dragging||ev.pointerId!==pointerId)return;drag=worldPos(ev);dragging=false;pointerId=null;let dx=ball.x-drag.x,dy=ball.y-drag.y;let len=Math.hypot(dx,dy);if(len<12)return;let ratio=Math.min(len,MAX_PULL)/len;dx*=ratio;dy*=ratio;
 // Reject near-downwards shots, but allow horizontal and lofted ones.
 ball.vx=dx*SHOOT_FACTOR;ball.vy=Math.min(dy*SHOOT_FACTOR,100);ball.rest=false;state='flying';strokes++;stillTimer=0;afterShot=0;updateHUD();playTone(260,0.09,'sine');ev.preventDefault()}
canvas.addEventListener('pointerdown',onDown);canvas.addEventListener('pointermove',onMove);canvas.addEventListener('pointerup',onUp);canvas.addEventListener('pointercancel',()=>{dragging=false;pointerId=null});
$('resetBtn').onclick=()=>openModal('Recommencer','↻','Nouvelle partie ?','Tu repartiras du premier trou avec un score à zéro.','Recommencer →',start);
$('soundBtn').onclick=()=>{sound=!sound;$('soundBtn').textContent=sound?'🔊 Son':'🔇 Muet'};
let audio;
function playTone(freq,duration,type='sine'){if(!sound)return;try{audio=audio||new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();let osc=audio.createOscillator(),gain=audio.createGain();osc.frequency.setValueAtTime(freq,audio.currentTime);osc.type=type;gain.gain.setValueAtTime(.075,audio.currentTime);gain.gain.exponentialRampToValueAtTime(.001,audio.currentTime+duration);osc.connect(gain);gain.connect(audio.destination);osc.start();osc.stop(audio.currentTime+duration)}catch(e){}}
function particleBurst(x,y){for(let i=0;i<36;i++){let a=Math.random()*Math.PI*2,s=100+Math.random()*240;particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-90,life:.7+Math.random()*.6,color:['#ffce69','#fff','#58cfba','#ff8fa4','#708dfb'][i%5],r:3+Math.random()*4})}}
function toast(t){ui.toast.textContent=t;ui.toast.classList.add('show');toastTimer=1.65}
function endHole(success){if(state==='modal')return;state='modal';ball.vx=0;ball.vy=0;ball.rest=true;let earned=success?Math.max(0,4-strokes):0;total+=earned;updateHUD();if(success){playTone(520,.19);particleBurst(hole.x,hole.y-16);setTimeout(()=>playTone(700,.15),130)}let isLast=current===courses.length-1;setTimeout(()=>{if(isLast){openModal('Parcours terminé',total>=14?'🏆':'⛳','Partie terminée !',`Tu as marqué <b>${total} points sur 18</b>. ${total>=14?'Excellent parcours !':'Tu peux faire encore mieux avec un peu d’entraînement.'}`,'Rejouer →',start,`<div class="resultscore">${total} / 18</div><div class="progress"><div style="width:${total/18*100}%"></div></div>`)}else{let nextName=courses[current+1].name;openModal(success?`Trou ${current+1} terminé`:'3 coups utilisés',success?'🎉':'⛳',success?'Dans le trou !':'Pas cette fois !',success?`<b>+${earned} point${earned>1?'s':''}</b> en ${strokes} coup${strokes>1?'s':''}.<br>Score cumulé : ${total} points.`:`Aucun point sur ce trou.<br>Score cumulé : ${total} points.`,`Trou suivant →`,()=>setCourse(current+1),`<p class="small">Prochain trou : <b>${nextName}</b></p>`) }},success?730:430)}
function physic(dt){if(state!=='flying')return;afterShot+=dt;let c=courses[current];let wind=c.wind*14;
 ball.vx+=(wind-0.003*ball.vx*Math.abs(ball.vx))*dt;ball.vy+=GRAVITY*dt;
 let prevY=ball.y;ball.x+=ball.vx*dt;ball.y+=ball.vy*dt;
 if(ball.x<BALL_R){ball.x=BALL_R;ball.vx=Math.abs(ball.vx)*.5}if(ball.x>1000-BALL_R){ball.x=1000-BALL_R;ball.vx=-Math.abs(ball.vx)*.5}
 for(let b of c.bumpers){let cx=Math.max(b.x,Math.min(ball.x,b.x+b.w)),cy=Math.max(b.y,Math.min(ball.y,b.y+b.h)),dx=ball.x-cx,dy=ball.y-cy;if(dx*dx+dy*dy<BALL_R*BALL_R){if(prevY+BALL_R<=b.y+2){ball.y=b.y-BALL_R;ball.vy=-Math.abs(ball.vy)*.48;ball.vx*=.8}else{ball.x=ball.x<b.x?b.x-BALL_R:b.x+b.w+BALL_R;ball.vx*=-.55;ball.vy*=.8}playTone(150,.04)}}
 let g=terrain(ball.x);if(ball.y+BALL_R>=g){ball.y=g-BALL_R;if(Math.abs(ball.vy)>105){ball.vy=-Math.abs(ball.vy)*.43;ball.vx*=.81;playTone(150+Math.random()*60,.045)}else{ball.vy=0;let sl=slope(ball.x);ball.vx+=-GRAVITY*.25*sl*dt;ball.vx*=Math.exp(-2.2*dt)}}
 if(Math.abs(ball.x-hole.x)<20&&ball.y+BALL_R>=hole.y-20&&Math.abs(ball.vx)<190&&Math.abs(ball.vy)<270){ball.x=hole.x;ball.y=hole.y-4;endHole(true);return}
 if(ball.y>680){ball.y=terrain(ball.x)-BALL_R;ball.vx=0;ball.vy=0}
 let touching=ball.y+BALL_R>=terrain(ball.x)-1.5;
 if(touching&&Math.abs(ball.vx)<14&&Math.abs(ball.vy)<12)stillTimer+=dt;else stillTimer=0;
 if(stillTimer>.58||afterShot>11){ball.vx=0;ball.vy=0;ball.rest=true;ball.y=terrain(ball.x)-BALL_R;stillTimer=0;if(strokes>=3)endHole(false);else{state='ready';updateHUD();toast('À toi de jouer !')}}
}
function roundRect(x,y,w,h,r,fill){ctx.fillStyle=fill;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}
function background(){let c=courses[current],grad=ctx.createLinearGradient(0,0,0,620);grad.addColorStop(0,c.sky[0]);grad.addColorStop(1,c.sky[1]);ctx.fillStyle=grad;ctx.fillRect(0,0,1000,620);
ctx.fillStyle='#ffefb2';ctx.globalAlpha=.86;ctx.beginPath();ctx.arc(820,135,45,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
 for(let i=0;i<5;i++){let x=((i*245+45+elapsed*(8+i*1.8))%1350)-150,y=120+i%3*60;ctx.globalAlpha=.43;ctx.fillStyle='#fff';ctx.beginPath();ctx.ellipse(x,y,50,16,0,0,Math.PI*2);ctx.ellipse(x+24,y-12,34,22,0,0,Math.PI*2);ctx.ellipse(x-24,y-7,28,18,0,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;
 ctx.fillStyle=current>=4?'#c5b5a4':'#a9d5c1';ctx.beginPath();ctx.moveTo(0,505);for(let x=0;x<=1000;x+=20)ctx.lineTo(x,410+26*Math.sin(x/93+1)+15*Math.sin(x/53));ctx.lineTo(1000,620);ctx.lineTo(0,620);ctx.fill();
}
function drawGround(){let desert=current===2||current===4||current===5;ctx.beginPath();ctx.moveTo(0,terrain(0));for(let x=4;x<=1000;x+=4)ctx.lineTo(x,terrain(x));ctx.lineTo(1000,650);ctx.lineTo(0,650);ctx.closePath();ctx.fillStyle=desert?'#dcb578':'#6eaf66';ctx.fill();
ctx.beginPath();ctx.moveTo(0,terrain(0));for(let x=4;x<=1000;x+=4)ctx.lineTo(x,terrain(x));ctx.lineWidth=14;ctx.lineJoin='round';ctx.strokeStyle=desert?'#f6d891':'#88cc76';ctx.stroke();ctx.lineWidth=3;ctx.strokeStyle=desert?'#ffe4a5':'#b6e995';ctx.stroke();
ctx.globalAlpha=.13;for(let i=0;i<75;i++){let x=(i*131+37)%1000,y=terrain(x)+30+(i*41)%140;ctx.fillStyle=desert?'#825329':'#144c35';ctx.beginPath();ctx.arc(x,y,2+i%3,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;
 for(let b of courses[current].bumpers){roundRect(b.x,b.y,b.w,b.h,5,'#647985');roundRect(b.x+5,b.y+4,b.w-10,8,3,'#9aacb4')}
}
function drawHole(){let x=hole.x,y=hole.y;ctx.fillStyle='#183b2b';ctx.beginPath();ctx.ellipse(x,y+2,22,6,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#f7f8fd';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(x+13,y);ctx.lineTo(x+13,y-87);ctx.stroke();ctx.fillStyle='#f46a65';ctx.beginPath();ctx.moveTo(x+14,y-86);ctx.lineTo(x+65,y-75);ctx.lineTo(x+14,y-62);ctx.closePath();ctx.fill();ctx.fillStyle='rgba(255,255,255,.84)';ctx.font='bold 12px system-ui';ctx.fillText('⛳',x+21,y-105)}
function drawBall(){ctx.fillStyle='#27465938';ctx.beginPath();ctx.ellipse(ball.x+4,terrain(ball.x)+3,15,4,0,0,Math.PI*2);ctx.fill();let gradient=ctx.createRadialGradient(ball.x-4,ball.y-5,2,ball.x,ball.y,BALL_R);gradient.addColorStop(0,'white');gradient.addColorStop(1,'#d4dce4');ctx.fillStyle=gradient;ctx.beginPath();ctx.arc(ball.x,ball.y,BALL_R,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#8192a3';ctx.lineWidth=1.3;ctx.stroke();ctx.fillStyle='#a5bac8';for(let [x,y] of [[-3,-3],[4,-1],[0,5]]){ctx.beginPath();ctx.arc(ball.x+x,ball.y+y,1.25,0,Math.PI*2);ctx.fill()}}
function aim(){if(!dragging)return;let dx=ball.x-drag.x,dy=ball.y-drag.y,len=Math.hypot(dx,dy);if(len<1)return;let ratio=Math.min(MAX_PULL,len)/len;dx*=ratio;dy*=ratio;let power=Math.min(1,len/MAX_PULL);
 ctx.strokeStyle='rgba(255,255,255,.65)';ctx.lineWidth=4;ctx.setLineDash([5,8]);ctx.beginPath();ctx.moveTo(ball.x,ball.y);ctx.lineTo(ball.x+dx*1.25,ball.y+dy*1.25);ctx.stroke();ctx.setLineDash([]);
 ctx.strokeStyle='#213d50aa';ctx.lineWidth=14;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(ball.x,ball.y);ctx.lineTo(ball.x-dx,ball.y-dy);ctx.stroke();ctx.strokeStyle='#ffcf69';ctx.lineWidth=7;ctx.stroke();ctx.lineCap='butt';
 let px=ball.x,py=ball.y,vx=dx*SHOOT_FACTOR,vy=Math.min(dy*SHOOT_FACTOR,100),w=courses[current].wind*14;for(let t=0;t<1.5;t+=.045){vx+=(w-.003*vx*Math.abs(vx))*.045;vy+=GRAVITY*.045;px+=vx*.045;py+=vy*.045;if(px<0||px>1000||py+BALL_R>terrain(px))break;ctx.globalAlpha=.75*(1-t/1.7);ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(px,py,Math.max(2.1,4.5-t*1.4),0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;
 roundRect(ball.x-50,ball.y-67,100,10,6,'#193d56aa');roundRect(ball.x-48,ball.y-65,96*power,6,4,power>.8?'#ff7979':'#ffce69');ctx.fillStyle='white';ctx.textAlign='center';ctx.font='800 14px system-ui';ctx.fillText(`${Math.round(power*100)} %`,ball.x,ball.y-78);ctx.textAlign='start'
}
function drawParticles(dt){for(let p of particles){p.vy+=440*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt;ctx.globalAlpha=Math.max(0,Math.min(1,p.life));ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,p.r,p.r)}ctx.globalAlpha=1;particles=particles.filter(p=>p.life>0)}
