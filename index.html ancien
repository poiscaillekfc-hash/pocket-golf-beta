<style>
:root{--ink:#15314a;--muted:#647589;--yellow:#ffce69;--green:#43a881}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#10243a;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;touch-action:none;color:white}#app{position:relative;width:100%;height:100%;overflow:hidden}canvas{width:100%;height:100%;display:block;touch-action:none}.hud{position:absolute;left:0;right:0;top:0;display:flex;gap:10px;padding:calc(env(safe-area-inset-top) + 12px) max(12px,env(safe-area-inset-right)) 0 max(12px,env(safe-area-inset-left));align-items:flex-start;pointer-events:none}.pill{background:rgba(16,36,58,.81);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.17);border-radius:15px;padding:8px 12px;box-shadow:0 6px 22px #10243a26}.stats{display:flex;gap:9px;flex-wrap:wrap;flex:1}.stat .label{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#bcd0df;font-weight:750}.stat .value{font-weight:850;font-size:18px;line-height:1.2;font-variant-numeric:tabular-nums}.wind{min-width:100px;text-align:center}.wind .value{white-space:nowrap}.controls{position:absolute;bottom:calc(14px + env(safe-area-inset-bottom));left:12px;right:12px;display:flex;justify-content:space-between;align-items:end;pointer-events:none;gap:8px}.hint{pointer-events:none;max-width:310px;color:white;font-size:12px;line-height:1.35;padding:11px 12px;border-radius:13px;background:rgba(16,36,58,.65);backdrop-filter:blur(8px)}button{font:inherit;cursor:pointer;touch-action:manipulation;border:0}.btn{pointer-events:auto;background:#fff;color:#17354c;border-radius:13px;font-weight:800;padding:11px 14px;box-shadow:0 5px 0 #bbcbd7;min-height:43px}.btn:active{transform:translateY(3px);box-shadow:0 2px 0 #bbcbd7}.btn.secondary{background:#193c55;color:white;box-shadow:0 4px 0 #0c2537;border:1px solid #4b7488}.overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(10,26,44,.55);backdrop-filter:blur(7px);padding:18px;z-index:5}.overlay.hidden{display:none}.modal{width:min(440px,100%);background:#fff;color:#20364a;border-radius:25px;box-shadow:0 22px 65px #05182b70;overflow:hidden;text-align:center;padding:26px 24px 23px}.tag{font-size:11px;letter-spacing:1.5px;font-weight:900;color:#408b79;text-transform:uppercase}.modal h1{font-size:clamp(26px,6vw,39px);line-height:1.07;margin:10px 0 12px;letter-spacing:-1.3px}.modal p{color:#62778a;line-height:1.5;font-size:14px}.hero{font-size:53px;filter:drop-shadow(0 4px 0 #c0d6df);margin:7px}.primary{background:#ffca5f;color:#49330f;border-radius:14px;padding:14px 18px;font-weight:900;font-size:16px;box-shadow:0 5px 0 #d89c32;width:100%;margin-top:12px}.primary:active{transform:translateY(3px);box-shadow:0 2px 0 #d89c32}.key{display:inline-block;background:#eaf2f5;border-radius:7px;color:#32556c;padding:2px 6px;font-weight:800}.resultscore{font-size:56px;color:#36a67c;font-weight:950;line-height:1}.small{font-size:12px!important}.progress{height:8px;background:#e7eff2;border-radius:99px;margin-top:13px;overflow:hidden}.progress>div{height:100%;background:#52c496;border-radius:99px;transition:width .3s}.logo{font-weight:1000;letter-spacing:1.7px;font-size:13px}.toast{position:absolute;top:30%;left:50%;transform:translateX(-50%);background:#18374fe8;border:1px solid #ffffff40;border-radius:13px;padding:10px 16px;font-weight:800;white-space:nowrap;opacity:0;transition:opacity .22s;pointer-events:none;z-index:3}.toast.show{opacity:1}@media(max-width:480px){.hud{gap:5px}.stats{gap:5px}.pill{padding:7px 9px;border-radius:12px}.stat .value{font-size:15px}.stat .label{font-size:9px}.wind{min-width:84px}.hint{font-size:11px;max-width:235px}.controls{bottom:calc(9px + env(safe-area-inset-bottom))}.btn{padding:9px 10px;font-size:12px}}
</style>
